<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ARCOS.Module.IO.Guidance.LogicEditorDialog"
        Title="ARCOS 複合邏輯表達式編輯器 ($logic Builder)"
        Width="700" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="16">
        <!-- 1. 頂部說明卡片 -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="6" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Spacing="3">
                <TextBlock Text="🧩 ARCOS $logic 複合邏輯表達式視覺編輯器" FontWeight="Bold" Foreground="#1E293B" FontSize="14"/>
                <TextBlock Text="支援 IO 訊號 (&amp;, |, ~, !)、Variable 關係比較 (==, !=, &gt;, &lt;, &gt;=, &lt;=)、區間判定 (&lt;&gt;, &lt;/&gt;)、陣列空值 (==[]) 與括號群組" Foreground="#64748B" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- 2. 中央運算元構建區 (Tabs: IO vs Variable) -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="6" Padding="14" Margin="0,10" BorderBrush="#CBD5E1" BorderThickness="1">
            <TabControl x:Name="TabOperands">
                <!-- Tab 1: IO 訊號 -->
                <TabItem Header="🔌 IO 訊號 (Ports &amp; Aliases)" FontWeight="SemiBold" FontSize="12">
                    <StackPanel Spacing="10" Margin="4,8">
                        <TextBlock Text="選擇可用實體埠號或別名 (Input? / Output):" Foreground="#475569" FontSize="11"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox x:Name="CmbIoList" HorizontalAlignment="Stretch" CornerRadius="4"/>
                            <TextBox x:Name="TxtIoSearch" Grid.Column="1" Width="140" Watermark="🔍 篩選 IO..." Margin="6,0,0,0" CornerRadius="4" Height="30"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnInsertIo" Content="➕ 插入 IO 原樣 (例如 P0.0)" Background="#EEF2FF" Foreground="#4338CA" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="4" Padding="10,6" FontWeight="SemiBold"/>
                            <Button x:Name="BtnInsertNotIo" Content="➕ 插入 NOT IO (~P0.0)" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="10,6" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- Tab 2: Variable 變數條件與比較 -->
                <TabItem Header="📊 Variable 變數條件 (Comparisons &amp; Ranges)" FontWeight="SemiBold" FontSize="12">
                    <StackPanel Spacing="10" Margin="4,8">
                        <Grid ColumnDefinitions="1.2*,110,*">
                            <!-- 變數名 -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="變數名稱 (可下拉選擇或手動輸入):" Foreground="#475569" FontSize="11" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*,*">
                                    <ComboBox x:Name="CmbVarNames" HorizontalAlignment="Stretch" CornerRadius="4" Margin="0,0,4,0"/>
                                    <TextBox x:Name="TxtCustomVar" Grid.Column="1" Watermark="自訂變數..." CornerRadius="4" Height="30"/>
                                </Grid>
                            </StackPanel>

                            <!-- 運算子 -->
                            <StackPanel Grid.Column="1" Spacing="4" Margin="6,0">
                                <TextBlock Text="比較符 (Op):" Foreground="#475569" FontSize="11" FontWeight="SemiBold"/>
                                <ComboBox x:Name="CmbVarOps" HorizontalAlignment="Stretch" CornerRadius="4"/>
                            </StackPanel>

                            <!-- 閥值/範圍 -->
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock x:Name="LblVarVal" Text="比對數值/範圍 (Value):" Foreground="#475569" FontSize="11" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtVarVal" CornerRadius="4" Height="30"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnInsertVarCond" Content="➕ 插入變數條件式 (例如 Count &gt; 10)" Background="#F0FDF4" Foreground="#15803D" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="10,6" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtVarSyntaxHint" Text="提示：區間請使用 min~max (例如 20~80)" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>

        <!-- 3. 邏輯運算子快捷工具列 -->
        <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="運算符工具列:" FontWeight="SemiBold" Foreground="#334155" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <WrapPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnOpAnd" Content="&amp; (AND)" Margin="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,4" FontWeight="Bold" Foreground="#1E293B"/>
                    <Button x:Name="BtnOpOr" Content="| (OR)" Margin="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,4" FontWeight="Bold" Foreground="#1E293B"/>
                    <Button x:Name="BtnOpNot" Content="~ (NOT)" Margin="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,4" FontWeight="Bold" Foreground="#1E293B"/>
                    <Button x:Name="BtnOpOpenParen" Content="( 括號" Margin="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,4" FontWeight="Bold" Foreground="#1E293B"/>
                    <Button x:Name="BtnOpCloseParen" Content=") 括號" Margin="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,4" FontWeight="Bold" Foreground="#1E293B"/>
                    <Button x:Name="BtnBackspace" Content="⌫ 倒退" Margin="3" Background="#FEF3C7" Foreground="#B45309" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="10,4" FontWeight="SemiBold"/>
                    <Button x:Name="BtnClear" Content="🗑️ 清空" Margin="3" Background="#FEE2E2" Foreground="#B91C1C" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="10,4" FontWeight="SemiBold"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 4. 表達式文字編輯區與即時語法校驗 -->
        <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="6" Padding="12" BorderBrush="#94A3B8" BorderThickness="1" Margin="0,0,0,10">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="當前 $logic 表達式 (可直接手動輸入或由上方點擊插入):" FontWeight="SemiBold" Foreground="#0F172A" FontSize="12"/>
                    <Button x:Name="BtnEvalLive" Grid.Column="1" Content="⚡ 立即試算當前狀態" Background="#F0FDF4" Foreground="#16A34A" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="8,2" FontSize="11" FontWeight="SemiBold"/>
                </Grid>
                <TextBox x:Name="TxtExpression" Height="68" AcceptsReturn="False" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" CornerRadius="4" Padding="8" BorderBrush="#CBD5E1"/>
                
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="TxtValidationStatus" Text="✅ 語法有效 (Syntax Valid)" Foreground="#16A34A" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtEvalResult" Grid.Column="1" Text="試算狀態: 未執行" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 5. 底部確定與取消按鈕 -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="提示：產生的邏輯式將自動帶回呼叫處之 $logic 欄位" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
            <Button x:Name="BtnCancel" Grid.Column="1" Content="取消" Width="80" HorizontalContentAlignment="Center" Background="#F1F5F9" Foreground="#475569" CornerRadius="4" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="BtnApply" Grid.Column="2" Content="✔ 確定帶入" Width="100" HorizontalContentAlignment="Center" Background="#2563EB" Foreground="#FFFFFF" CornerRadius="4" FontWeight="Bold" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
