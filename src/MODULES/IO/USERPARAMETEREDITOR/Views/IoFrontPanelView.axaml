<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MVCON.Module.IO.Guidance.Views"
             x:Class="MVCON.Module.IO.Guidance.Views.IoFrontPanelView"
             Background="#0F172A">

    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            
            <!-- 1. 頂部標題與驅動中繼資訊 -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <StackPanel Grid.Column="0" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="⚡ IO MODULE FRONT PANEL" FontWeight="Black" FontSize="15" Foreground="#38BDF8"/>
                        <Border Background="#0284C7" CornerRadius="3" Padding="6,1">
                            <TextBlock Text="CSVI SUBPANEL &amp; DRIVER HMI" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="即時電位反射 · 手動點動切換 · 動態嵌入 SubPanel" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- 驅動狀態膠囊 -->
                <Border Grid.Column="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#10B981"/>
                        <TextBlock Text="{Binding DriverName}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. 即時狀態儀表卡片群 -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,0,0,12">
                <!-- 作用中點位數 -->
                <Border Grid.Column="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,4,0">
                    <StackPanel Spacing="1">
                        <TextBlock Text="ACTIVE ON BITS" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding ActiveCount}" FontSize="16" FontWeight="Black" Foreground="#10B981"/>
                    </StackPanel>
                </Border>

                <!-- 最後執行指令 -->
                <Border Grid.Column="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="2,0">
                    <StackPanel Spacing="1">
                        <TextBlock Text="LAST EXECUTED COMMAND" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding LastCommand}" FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <!-- 執行時間 -->
                <Border Grid.Column="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="4,0,0,0">
                    <StackPanel Spacing="1">
                        <TextBlock Text="EXECUTION TIMESTAMP" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding LastExecTime}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. 數位 IO 點位矩陣 (16 點位即時燈號與手動點擊) -->
            <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Bits}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Margin="3" Padding="8,6">
                                    <Grid ColumnDefinitions="45,*,Auto">
                                        <!-- Port 名稱 (藍底標籤) -->
                                        <Border Grid.Column="0" Background="#0284C7" CornerRadius="3" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Port}" FontSize="10" FontWeight="Black" Foreground="White"/>
                                        </Border>

                                        <!-- 別名 -->
                                        <TextBlock Grid.Column="1" Text="{Binding Alias}" FontSize="11" FontWeight="SemiBold" Foreground="#F1F5F9"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>

                                        <!-- 狀態燈號 + 手動切換按鈕 -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Fill="{Binding StateBrush}" Stroke="#64748B" StrokeThickness="1"/>
                                            <Button Content="{Binding StateText}" Width="44" Height="22" Padding="0"
                                                    FontSize="9.5" FontWeight="Bold"
                                                    Background="{Binding StateBrush}" Foreground="White"
                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Click="OnBitToggleClick" Tag="{Binding Port}" CornerRadius="3"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 4. 底部狀態說明 -->
            <Border Grid.Row="3" Background="#0F172A" CornerRadius="4" Padding="8,4" Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="💡 提示：本 User Panel 既是指令也是驅動儀表，點擊按鈕可手動切換電位，底層執行時燈號將同步即時跳動" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="🔄 刷新全部" Click="OnRefreshAllClick"
                            Height="22" Padding="10,0" Background="#334155" Foreground="#E2E8F0" FontSize="10" CornerRadius="3"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
