  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\ARCOS.Core\ARCOS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="CSVI.Manifest.json" LogicalName="CSVI.Manifest.json" />
