<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ARCOS.Driver.MockCamera.MockCameraView"
             Background="#1E1E1E">
    <Grid Margin="12" RowDefinitions="Auto,Auto,*">
        <!-- 頂部資訊列 -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="[Capture 視覺相機] " FontWeight="Bold" Foreground="#4EC9B0" FontSize="14"/>
                    <TextBlock x:Name="TxtDeviceInfo" Text="Device: Cam0" Foreground="#CCCCCC" FontSize="14"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse x:Name="LedOk" Width="14" Height="14" Fill="Gray" Stroke="White" Margin="4,0"/>
                    <TextBlock Text="OK?" Foreground="LightGray" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 圖檔選擇與操作按鈕列 -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <Grid RowDefinitions="Auto,Auto">
                <!-- 第一行：圖檔路徑輸入與瀏覽按鈕 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="載入圖片路徑: " Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="BtnBrowseImage" DockPanel.Dock="Right" Content="選擇圖片 (Browse)" Width="120" Height="28" Background="#3E3E42" Foreground="White" Margin="8,0,0,0"/>
                    <Button x:Name="BtnLoadImage" DockPanel.Dock="Right" Content="載入 (Load)" Width="80" Height="28" Background="#0F766E" Foreground="White" Margin="8,0,0,0"/>
                    <TextBox x:Name="TxtImagePath" Text="" Watermark="輸入或瀏覽圖檔路徑 (.jpg, .png, .bmp)..." Background="#1E1E1E" Foreground="#4EC9B0" BorderBrush="#3F3F46"/>
                </DockPanel>

                <!-- 第二行：拍照與飛拍按鈕與狀態 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnSnap" Content="觸發單張取像 (Snap)" Width="150" Height="30" Background="#0E639C" Foreground="White"/>
                    <Button x:Name="BtnTrigger" Content="觸發飛拍 (Trigger)" Width="140" Height="30" Background="#238636" Foreground="White"/>
                    <TextBlock Text="累計幀數: " Foreground="LightGray" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock x:Name="TxtFrameCount" Text="0" FontWeight="Bold" Foreground="#4EC9B0" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 影像預覽顯示區 -->
        <Border Grid.Row="2" Background="#111111" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4">
            <Grid>
                <TextBlock x:Name="TxtPlaceholder" Text="尚無影像，請點擊 Snap 或選擇圖片載入" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                <Image x:Name="ImgPreview" Stretch="Uniform" Margin="10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
