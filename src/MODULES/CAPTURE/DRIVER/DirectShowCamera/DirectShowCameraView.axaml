<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ARCOS.Driver.DirectShowCamera.DirectShowCameraView"
             Background="#1E1E1E">
    <Grid Margin="12" RowDefinitions="Auto,Auto,*">
        <!-- 頂部狀態列 -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="[Capture DirectShow 相機]" FontWeight="Bold" Foreground="#38BDF8" FontSize="14"/>
                    <TextBlock x:Name="TxtDeviceInfo" Text="Cam0 (DirectShowCamera)" Foreground="#E2E8F0" FontSize="13"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Ellipse x:Name="LedConn" Width="12" Height="12" Fill="Gray" Stroke="White"/>
                        <TextBlock x:Name="TxtConnState" Text="OFFLINE" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Ellipse x:Name="LedOk" Width="12" Height="12" Fill="Gray" Stroke="White"/>
                        <TextBlock Text="OK?" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 相機選擇與取像參數控制列 -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel Spacing="8">
                <!-- 第一行：DirectShow 裝置清單與連線控制 -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="DirectShow 裝置:" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbDevices" Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="28" Margin="0,0,6,0"/>
                    <Button x:Name="BtnRescan" Grid.Column="2" Content="↻ 重新掃描" Height="28" Padding="10,0" Background="#334155" Foreground="White" Margin="0,0,6,0"/>
                    <Button x:Name="BtnOpen" Grid.Column="3" Content="連線 (Open)" Height="28" Padding="12,0" Background="#0E639C" Foreground="White" Margin="0,0,6,0"/>
                    <Button x:Name="BtnClose" Grid.Column="4" Content="斷線 (Close)" Height="28" Padding="10,0" Background="#475569" Foreground="White" Margin="0,0,8,0"/>
                    <CheckBox x:Name="ChkLive" Grid.Column="5" Content="即時預覽 (Live)" IsChecked="True" Foreground="#34D399" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>

                <!-- 第二行：解析度 / FourCC / Flip / 曝光 / 套用 -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="解析度:" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbResolution" Width="118" MinHeight="28"/>
                    <TextBlock Text="編碼:" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbFourCC" Width="82" MinHeight="28"/>
                    <TextBlock Text="翻轉:" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbFlip" Width="76" MinHeight="28"/>
                    <TextBlock Text="曝光:" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbExposure" Width="80" MinHeight="28"/>
                    <Button x:Name="BtnApplyConfig" Content="套用設定" Height="28" Padding="12,0" Background="#0F766E" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- 第三行：Snap / Trigger 與狀態顯示 -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnSnap" Content="單張取像 (Snap)" Width="140" Height="30" Background="#0284C7" Foreground="White" FontWeight="SemiBold"/>
                        <Button x:Name="BtnTrigger" Content="飛拍壓入 (Trigger)" Width="140" Height="30" Background="#16A34A" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Text="累計幀數:" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock x:Name="TxtFrameCount" Text="0" FontWeight="Bold" Foreground="#38BDF8" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtErrorBanner" DockPanel.Dock="Right" Text="" Foreground="#F87171" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 影像顯示區 -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4">
            <Grid>
                <TextBlock x:Name="TxtPlaceholder" Text="尚未取得 DirectShow 相機畫面，請確認鏡頭已連接後點擊「連線」或「Snap」"
                           Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                <Image x:Name="ImgPreview" Stretch="Uniform" Margin="8"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
