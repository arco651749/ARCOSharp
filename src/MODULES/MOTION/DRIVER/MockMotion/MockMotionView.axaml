<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ARCOS.Driver.MockMotion.MockMotionView"
             Background="#1E1E1E">
    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto">
        <!-- 頂部資訊列與狀態燈 -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="[Motion 驅動]" FontWeight="Bold" Foreground="#4EC9B0" FontSize="14"/>
                    <TextBlock x:Name="TxtDeviceInfo" Text="Device: Motor1" Foreground="#CCCCCC" FontSize="14"/>
                    <TextBlock x:Name="TxtToolInfo" Text="Tool: Tool0" Foreground="#9CDCFE" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtMoveMode" Text="Mode: LINEAR_MOVE" Foreground="#DCDCAA" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse x:Name="LedHomed" Width="12" Height="12" Fill="Gray" Stroke="White" Margin="4,0"/>
                    <TextBlock Text="Homed" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Ellipse x:Name="LedBusy" Width="12" Height="12" Fill="Gray" Stroke="White" Margin="4,0"/>
                    <TextBlock Text="Busy" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Ellipse x:Name="LedDone" Width="12" Height="12" Fill="LimeGreen" Stroke="White" Margin="4,0"/>
                    <TextBlock Text="Done" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Ellipse x:Name="LedAlarm" Width="12" Height="12" Fill="Gray" Stroke="White" Margin="4,0"/>
                    <TextBlock x:Name="TxtErrorCode" Text="Alarm (Err:0)" Foreground="LightGray" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 6 軸當前座標顯示 -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,*,*,*,*,*">
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="X / J1" Foreground="#9CDCFE" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtX" Text="0.000" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Y / J2" Foreground="#9CDCFE" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtY" Text="0.000" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Z / J3" Foreground="#9CDCFE" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtZ" Text="0.000" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="U / J4" Foreground="#CE9178" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtU" Text="0.000" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="V / J5" Foreground="#CE9178" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtV" Text="0.000" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                    <TextBlock Text="W / J6" Foreground="#CE9178" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtW" Text="0.000" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 手動 Jog 點動與控制按鈕 -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Jog 步長: " Foreground="LightGray" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtJogStep" Text="10.0" Width="60" Background="#333337" Foreground="White" Margin="5,0,15,0"/>
                    <Button x:Name="BtnHome" Content="原點復歸 (Home)" Width="120" Height="28" Background="#0E639C" Foreground="White" Margin="0,0,8,0"/>
                    <Button x:Name="BtnStop" Content="急停 (Stop)" Width="90" Height="28" Background="#A1260D" Foreground="White"/>
                </StackPanel>

                <!-- Jog 按鈕矩陣 -->
                <UniformGrid Grid.Row="1" Rows="3" Columns="2" Margin="20,4,20,4">
                    <Button x:Name="BtnXMinus" Content="X - 點動" Height="32" Margin="3" Background="#3E3E42" Foreground="White"/>
                    <Button x:Name="BtnXPlus" Content="X + 點動" Height="32" Margin="3" Background="#3E3E42" Foreground="White"/>
                    <Button x:Name="BtnYMinus" Content="Y - 點動" Height="32" Margin="3" Background="#3E3E42" Foreground="White"/>
                    <Button x:Name="BtnYPlus" Content="Y + 點動" Height="32" Margin="3" Background="#3E3E42" Foreground="White"/>
                    <Button x:Name="BtnZMinus" Content="Z - 點動" Height="32" Margin="3" Background="#3E3E42" Foreground="White"/>
                    <Button x:Name="BtnZPlus" Content="Z + 點動" Height="32" Margin="3" Background="#3E3E42" Foreground="White"/>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ExtraCMD 原生指令說明與測試面板 -->
        <Border Grid.Row="3" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10">
            <StackPanel Spacing="4">
                <DockPanel>
                    <TextBlock Text="ExtraCMD 控制器原生指令說明 (Native Commands):" FontWeight="Bold" Foreground="#4EC9B0" FontSize="12"/>
                    <TextBlock x:Name="TxtLastExtraCmd" Text="LastExtraCMD: (None)" Foreground="#DCDCAA" FontSize="11" HorizontalAlignment="Right"/>
                </DockPanel>
                <TextBlock Text="• PWR ON | PWR OFF : 切換馬達激磁   • SPEED &lt;val&gt; | ACCEL &lt;val&gt; : 設定控制器全域速度/加速度" Foreground="#CCCCCC" FontSize="11"/>
                <TextBlock Text="• DOUT &lt;idx&gt;,&lt;0|1&gt; : 控制手臂自帶DO  • ERR &lt;code&gt; | RST : 模擬觸發控制器 ErrorCode / 清除錯誤" Foreground="#CCCCCC" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
