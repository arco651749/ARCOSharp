<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MVCON.Driver.MockMotion.MockMotionView"
             Background="#1E1E1E">
    <Grid Margin="15" RowDefinitions="Auto,Auto,*">
        <!-- 頂部資訊列與狀態燈 -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="[Motion 驅動] " FontWeight="Bold" Foreground="#4EC9B0" FontSize="14"/>
                    <TextBlock x:Name="TxtDeviceInfo" Text="Device: Motor1" Foreground="#CCCCCC" FontSize="14"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse x:Name="LedHomed" Width="14" Height="14" Fill="Gray" Stroke="White" Margin="4,0"/>
                    <TextBlock Text="Homed" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Ellipse x:Name="LedBusy" Width="14" Height="14" Fill="Gray" Stroke="White" Margin="4,0"/>
                    <TextBlock Text="Busy" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Ellipse x:Name="LedDone" Width="14" Height="14" Fill="LimeGreen" Stroke="White" Margin="4,0"/>
                    <TextBlock Text="Done" Foreground="LightGray" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 6 軸當前座標顯示 -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,*,*,*,*,*">
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="X (mm)" Foreground="#9CDCFE" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtX" Text="0.000" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Y (mm)" Foreground="#9CDCFE" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtY" Text="0.000" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Z (mm)" Foreground="#9CDCFE" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtZ" Text="0.000" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="U (deg)" Foreground="#CE9178" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtU" Text="0.000" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="V (deg)" Foreground="#CE9178" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtV" Text="0.000" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                    <TextBlock Text="W (deg)" Foreground="#CE9178" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtW" Text="0.000" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 手動 Jog 點動與控制按鈕 -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="15">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Jog 步長: " Foreground="LightGray" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtJogStep" Text="10.0" Width="60" Background="#333337" Foreground="White" Margin="5,0,20,0"/>
                    <Button x:Name="BtnHome" Content="原點復歸 (Home)" Width="130" Height="30" Background="#0E639C" Foreground="White" Margin="0,0,10,0"/>
                    <Button x:Name="BtnStop" Content="急停 (Stop)" Width="100" Height="30" Background="#A1260D" Foreground="White"/>
                </StackPanel>

                <!-- Jog 按鈕矩陣 -->
                <UniformGrid Grid.Row="1" Rows="3" Columns="2" Margin="40,10,40,10">
                    <Button x:Name="BtnXMinus" Content="X - 點動" Height="38" Margin="5" Background="#3E3E42" Foreground="White"/>
                    <Button x:Name="BtnXPlus" Content="X + 點動" Height="38" Margin="5" Background="#3E3E42" Foreground="White"/>
                    <Button x:Name="BtnYMinus" Content="Y - 點動" Height="38" Margin="5" Background="#3E3E42" Foreground="White"/>
                    <Button x:Name="BtnYPlus" Content="Y + 點動" Height="38" Margin="5" Background="#3E3E42" Foreground="White"/>
                    <Button x:Name="BtnZMinus" Content="Z - 點動" Height="38" Margin="5" Background="#3E3E42" Foreground="White"/>
                    <Button x:Name="BtnZPlus" Content="Z + 點動" Height="38" Margin="5" Background="#3E3E42" Foreground="White"/>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
