<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16" Background="#F8FAFC">
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Call@hi.csvi — 參數導引精靈" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="語法: &lt;訊息文字或 $變數&gt; (留空預設 hi)" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="TxtParamInInfo" Text="ParameterIn: (空白)" Foreground="#94A3B8" FontSize="11" FontFamily="Consolas" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
            <Grid ColumnDefinitions="*,114">
                <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="$message (輸出訊息文字或參照 $變數):" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                        <TextBlock Grid.Column="1" Name="TxtVarMeta" Text="Presets + Variable List" FontSize="11" Foreground="#475569"/>
                    </Grid>
                    <Border BorderBrush="#2563EB" BorderThickness="1.5" CornerRadius="5" Padding="2" Background="White">
                        <Grid>
                            <ComboBox Name="CmbCallInput" Height="34" HorizontalAlignment="Stretch" BorderThickness="0" Background="Transparent"/>
                            <TextBox Name="TxtCallInput" Margin="0,0,32,0" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" BorderThickness="0" Background="White" FontSize="13" Foreground="#0F172A" Watermark="例如 hi 或 $GreetingVar"/>
                        </Grid>
                    </Border>

                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <TextBlock Name="TxtCatalog" Text="準備載入訊息與變數預覽..." Foreground="#1E40AF" FontSize="11.5" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Name="BtnOk"
                        Background="#10B981" Foreground="White" CornerRadius="8"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="4,8,0,4"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Cursor="Hand" ToolTip.Tip="套用目前組合參數 (Enter)">
                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="✓" FontSize="34" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="套用參數" FontSize="13" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,12,0">
                    <TextBlock Text="ParameterOut (組合預覽):" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                    <TextBox Name="TxtParamOut" IsReadOnly="True" Background="#F1F5F9" Foreground="#0284C7"
                             FontWeight="Bold" FontFamily="Consolas" FontSize="13" MinHeight="32" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Name="BtnCancel" Content="取消" Width="86" Height="36"
                        Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold"
                        VerticalAlignment="Bottom" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
