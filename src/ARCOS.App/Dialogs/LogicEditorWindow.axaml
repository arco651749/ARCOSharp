<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ARCOS.App.Dialogs"
        x:Class="ARCOS.App.Dialogs.LogicEditorWindow"
        Title="Logic Editor - $logic Expression Builder"
        Width="980" Height="710"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Light"
        Background="#F1F5F9">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="CaretBrush" Value="#0F172A"/>
            <Setter Property="SelectionBrush" Value="#2563EB"/>
            <Setter Property="SelectionForegroundBrush" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.opBtn">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.opBtn:pointerover">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
        </Style>
        <Style Selector="Button.opLogic">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.opLogic:pointerover">
            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>
        <Style Selector="ListBox.denseList ListBoxItem">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="14">

        <!-- 0. 頂部 深色橫幅 + 互動範例快速帶入 -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="12,9" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Logic Editor — $logic 邏輯運算式視覺編輯器"
                               FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="點選 IO、運算子或變數即於游標處插入；下方支援語法檢查與即時試算"
                               FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="範例:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                    <Button x:Name="BtnSampleIo" Content="IO聯鎖" Background="#1E293B" Foreground="#38BDF8"
                            BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="7,4" FontSize="11"
                            ToolTip.Tip="插入範例：(Sensor_Home? &amp; ~Alarm?)"/>
                    <Button x:Name="BtnSampleRange" Content="數值區間" Background="#1E293B" Foreground="#34D399"
                            BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="7,4" FontSize="11"
                            ToolTip.Tip="插入範例：(Temp &lt;&gt; 20~80)"/>
                    <Button x:Name="BtnSampleJson" Content="JSON/空值" Background="#1E293B" Foreground="#FBBF24"
                            BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="7,4" FontSize="11"
                            ToolTip.Tip="插入範例：(Data::status == OK) &amp; (Queue != [])"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. 主體三欄工作區：IO清單 | 分組運算子 | 變數與條件快速組裝 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,0,0,10">

            <!-- 左欄：IO 點位 (即時狀態與快速篩選) -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,5,0">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Text="IO 點位清單 (別名 / 虛擬 / 實體)" FontSize="13" FontWeight="Bold"
                                   Foreground="#1E293B" VerticalAlignment="Center"/>
                        <Button x:Name="BtnRefreshLive" Grid.Column="1" Content="刷新狀態"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="4" Padding="8,3" FontSize="11"
                                ToolTip.Tip="重新讀取 IoEngine 與 VariableEngine 目前即時狀態"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBox x:Name="TxtIoFilter" Grid.Column="0" Height="30" Padding="8,0" Margin="0,0,6,0"
                                 VerticalContentAlignment="Center" FontSize="12"
                                 Watermark="搜尋別名或 P0.0..."/>
                        <ComboBox x:Name="CmbIoMode" Grid.Column="1" Width="96" Height="30" FontSize="11"/>
                    </Grid>

                    <ListBox x:Name="LstIoPorts" Classes="denseList" Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0"
                             BorderThickness="1" CornerRadius="5" Padding="2" Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:LogicIoItem">
                                <Grid ColumnDefinitions="*,Auto" Margin="0">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding PrimaryName}" FontWeight="SemiBold"
                                                   Foreground="#0F172A" FontSize="11.5"/>
                                        <TextBlock Text="{Binding SubLabel}" Foreground="#64748B" FontSize="10.5"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{Binding StateBg}" BorderBrush="{Binding StateBorder}"
                                            BorderThickness="1" CornerRadius="3" Padding="5,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StateText}" Foreground="{Binding StateFg}"
                                                   FontSize="9.5" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="3" ColumnDefinitions="*,*">
                        <Button x:Name="BtnInsertIo" Grid.Column="0" Content="+ 插入原樣" Margin="0,0,3,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1"
                                CornerRadius="5" Padding="8,6" FontSize="12" FontWeight="Bold"/>
                        <Button x:Name="BtnInsertNotIo" Grid.Column="1" Content="~ 插入反相" Margin="3,0,0,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1"
                                CornerRadius="5" Padding="8,6" FontSize="12" FontWeight="Bold"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 中欄：分組運算子與存取修飾 (點擊即於游標處插入) -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="5,0,5,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="運算子與語法群組 (游標處插入)" FontSize="13" FontWeight="Bold"
                               Foreground="#1E293B" Margin="0,0,0,8"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <StackPanel Spacing="10">
                            <!-- 群組 1：邏輯與括號 -->
                            <StackPanel Spacing="5">
                                <TextBlock Text="邏輯連接與優先括號" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="BtnOpAnd" Classes="opLogic" Content="&amp; (AND)" ToolTip.Tip="邏輯且：兩側條件皆須成立"/>
                                    <Button x:Name="BtnOpOr" Classes="opLogic" Content="| (OR)" ToolTip.Tip="邏輯或：任一側條件成立即可"/>
                                    <Button x:Name="BtnOpNot" Classes="opLogic" Content="~ (NOT)" ToolTip.Tip="邏輯反相：反轉右側訊號或括號結果"/>
                                    <Button x:Name="BtnOpOpen" Classes="opLogic" Content="(" ToolTip.Tip="左括號"/>
                                    <Button x:Name="BtnOpClose" Classes="opLogic" Content=")" ToolTip.Tip="右括號"/>
                                    <Button x:Name="BtnOpWrap" Classes="opLogic" Content="(包裹選取)" ToolTip.Tip="以括號包裹目前反白選取的子運算式"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- 群組 2：數值與區間比較 -->
                            <StackPanel Spacing="5">
                                <TextBlock Text="數值、字串與區間比對" FontSize="11" FontWeight="Bold" Foreground="#0F766E"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="BtnOpEq" Classes="opBtn" Content="==" ToolTip.Tip="等於 (數值或字串)"/>
                                    <Button x:Name="BtnOpNeq" Classes="opBtn" Content="!=" ToolTip.Tip="不等於"/>
                                    <Button x:Name="BtnOpGt" Classes="opBtn" Content="&gt;" ToolTip.Tip="大於"/>
                                    <Button x:Name="BtnOpGte" Classes="opBtn" Content="&gt;=" ToolTip.Tip="大於等於"/>
                                    <Button x:Name="BtnOpLt" Classes="opBtn" Content="&lt;" ToolTip.Tip="小於"/>
                                    <Button x:Name="BtnOpLte" Classes="opBtn" Content="&lt;=" ToolTip.Tip="小於等於"/>
                                    <Button x:Name="BtnOpInRange" Classes="opBtn" Content="&lt;&gt; 區間內" ToolTip.Tip="數值位於區間內：Var &lt;&gt; min~max"/>
                                    <Button x:Name="BtnOpOutRange" Classes="opBtn" Content="&lt;/&gt; 區間外" ToolTip.Tip="數值超出區間外：Var &lt;/&gt; min~max"/>
                                    <Button x:Name="BtnOpTildeRange" Classes="opBtn" Content="~ (範圍)" ToolTip.Tip="區間上下界分隔符，例如 20~80"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- 群組 3：存在與空值 / 空陣列 -->
                            <StackPanel Spacing="5">
                                <TextBlock Text="變數存在與空值 / 空陣列檢測" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="BtnOpEqNull" Classes="opBtn" Content="==NULL" ToolTip.Tip="變數未定義或為空值"/>
                                    <Button x:Name="BtnOpNeqNull" Classes="opBtn" Content="!=NULL" ToolTip.Tip="變數已定義且非空值"/>
                                    <Button x:Name="BtnOpEqExist" Classes="opBtn" Content="==EXIST" ToolTip.Tip="變數已於記憶體中註冊"/>
                                    <Button x:Name="BtnOpNeqExist" Classes="opBtn" Content="!=EXIST" ToolTip.Tip="變數尚未於記憶體中註冊"/>
                                    <Button x:Name="BtnOpEqEmptyArr" Classes="opBtn" Content="==[]" ToolTip.Tip="一維陣列為空"/>
                                    <Button x:Name="BtnOpNeqEmptyArr" Classes="opBtn" Content="!=[]" ToolTip.Tip="一維陣列非空"/>
                                    <Button x:Name="BtnOpEqEmptyMat" Classes="opBtn" Content="==[;;]" ToolTip.Tip="多維/空白分隔陣列為空"/>
                                    <Button x:Name="BtnOpNeqEmptyMat" Classes="opBtn" Content="!=[;;]" ToolTip.Tip="多維陣列非空"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- 群組 4：Section 與 JSON -->
                            <StackPanel Spacing="5">
                                <TextBlock Text="區段指定與 JSON 欄位擷取" FontSize="11" FontWeight="Bold" Foreground="#6D28D9"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="BtnOpAtSection" Classes="opBtn" Content="@Section" ToolTip.Tip="附加右側選中區段名稱 (如 @Thread1)，指定變數作用域"/>
                                    <Button x:Name="BtnOpJsonPath" Classes="opBtn" Content="::JsonKey" ToolTip.Tip="擷取 JSON 字串內部欄位或陣列元素 (如 ::items[0]::code)"/>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="8,6">
                        <TextBlock Text="提示：區間寫法 Temp &lt;&gt; 20~80｜指定區段 Mode@Thread1｜JSON 取值 Data::status == OK"
                                   FontSize="10.5" Foreground="#475569" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 右欄：系統變數 (含即時值) + 條件快速組裝精靈 -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="5,0,0,0">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Text="系統變數與條件快速組裝" FontSize="13" FontWeight="Bold"
                                   Foreground="#1E293B" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtVarCount" Grid.Column="1" Text="0 項" FontSize="11"
                                   Foreground="#64748B" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="102,*" Margin="0,0,0,8">
                        <ComboBox x:Name="CmbVarSection" Grid.Column="0" Height="30" FontSize="11" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtVarFilter" Grid.Column="1" Height="30" Padding="8,0"
                                 VerticalContentAlignment="Center" FontSize="12"
                                 Watermark="搜尋變數名稱..."/>
                    </Grid>

                    <ListBox x:Name="LstVariables" Classes="denseList" Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0"
                             BorderThickness="1" CornerRadius="5" Padding="2" Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:LogicVarItem">
                                <Grid ColumnDefinitions="Auto,*" Margin="0">
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayKey}" FontWeight="SemiBold"
                                               Foreground="#1D4ED8" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PreviewValue}" Foreground="#475569"
                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 快速條件組裝子面板 -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                            CornerRadius="6" Padding="8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="快速組裝變數條件式" FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>
                            <Grid ColumnDefinitions="*,118">
                                <TextBox x:Name="TxtQuickVar" Grid.Column="0" Height="29" Padding="7,0" Margin="0,0,6,0"
                                         VerticalContentAlignment="Center" FontSize="12" Watermark="變數名 (或 Var::key)"/>
                                <ComboBox x:Name="CmbQuickOp" Grid.Column="1" Height="29" FontSize="12"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="TxtQuickVal" Grid.Column="0" Height="29" Padding="7,0" Margin="0,0,6,0"
                                         VerticalContentAlignment="Center" FontSize="12" Watermark="比較值 / min~max"/>
                                <Button x:Name="BtnInsertQuickCond" Grid.Column="1" Content="+ 插入條件式"
                                        Height="29" Padding="10,0"
                                        Background="#0F766E" Foreground="#FFFFFF" CornerRadius="4"
                                        FontSize="11" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. 底部 表達式編輯框 + 即時驗證/試算 + 套用/取消 -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="當前 $logic 表達式 (可直接手動編輯或由上方點選插入):"
                               FontSize="12" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Button x:Name="BtnUndoExpr" Grid.Column="1" Content="復原一步" Margin="6,0,0,0"
                            Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                            CornerRadius="4" Padding="10,4" FontSize="11" FontWeight="SemiBold"/>
                    <Button x:Name="BtnClearExpr" Grid.Column="2" Content="清空" Margin="6,0,0,0"
                            Background="#FEF2F2" Foreground="#B91C1C" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="4" Padding="10,4" FontSize="11" FontWeight="SemiBold"/>
                    <Button x:Name="BtnEvalLive" Grid.Column="3" Content="⚡ 立即試算現況" Margin="6,0,0,0"
                            Background="#EEF2FF" Foreground="#4338CA" BorderBrush="#C7D2FE" BorderThickness="1"
                            CornerRadius="4" Padding="12,4" FontSize="11" FontWeight="Bold"/>
                </Grid>

                <TextBox x:Name="TxtExpression" Height="64" AcceptsReturn="False" TextWrapping="Wrap"
                         FontFamily="Consolas, Courier New, monospace" FontSize="13.5" FontWeight="SemiBold"
                         Padding="9,7" VerticalContentAlignment="Top"/>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="TxtSyntaxStatus" Grid.Column="0" Text="✓ 語法有效 (Syntax Valid)" Margin="0,0,10,0"
                               FontSize="11.5" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtEvalResult" Grid.Column="1" Text="試算結果：尚未執行"
                               FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Text="提示：雙擊左側 IO 或右側變數亦可快速插入｜Ctrl+Enter 套用，Esc 取消"
                               FontSize="11" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="BtnCancel" Grid.Column="1" Content="取消" Width="80" Height="34" Margin="8,0,0,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="#E2E8F0" Foreground="#334155" CornerRadius="5" FontSize="12.5" FontWeight="SemiBold"
                            IsCancel="True"/>
                    <Button x:Name="BtnApply" Grid.Column="2" Content="✓ 套用表達式" Width="124" Height="34" Margin="8,0,0,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="#10B981" Foreground="#FFFFFF" CornerRadius="5" FontSize="12.5" FontWeight="Bold"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
