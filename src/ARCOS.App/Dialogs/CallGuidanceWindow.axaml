<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ARCOS.App.Dialogs.CallGuidanceWindow"
        Title="Call 模組 - 外部 CSVI 虛擬儀表選擇器"
        Width="580" Height="430"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        RequestedThemeVariant="Light"
        Background="#F8FAFC">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="18">
        <!-- 頂部標題區 -->
        <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="⚡ Call 外部模組導引" FontWeight="Bold" FontSize="14" Foreground="#1D4ED8"/>
                    <TextBlock Text="| 步驟 1: 挑選 ExternalModules/ 虛擬儀表與執行模式" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主要設定卡片 -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" BoxShadow="0 1 3 0 #10000000">
            <StackPanel Spacing="14">
                <!-- CSVI 選取 -->
                <TextBlock Text="目標 CSVI 虛擬儀表 (Target CSVI):" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                <Grid ColumnDefinitions="*,Auto">
                    <ComboBox Grid.Column="0" x:Name="CboCsviList" Height="32" HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" x:Name="BtnBrowse" Content="瀏覽檔案 (Browse)..." Height="32" Padding="12,0"/>
                </Grid>

                <TextBlock x:Name="TxtCsviInfo" Text="路徑: ExternalModules/" FontSize="11" Foreground="#64748B"/>

                <Separator Background="#E2E8F0" Margin="0,4"/>

                <!-- 執行模式 (Mode Suffix) -->
                <TextBlock Text="執行模式 (Execution Mode):" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                <StackPanel Spacing="8">
                    <RadioButton x:Name="RbRuntime" IsChecked="True">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Runtime 模式 (&amp;)" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="- 背景全速執行，不開視窗 (生產線預設標準)" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RbDebug">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Debug 模式 (無後綴)" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="- 顯示 FrontPanel 前面板調試視窗 (研發調機用)" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RbReentrant">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Reentrant 模式 (&amp;&amp;)" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="- 多執行緒並行可重入 (每次調用獨立實例)" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Separator Background="#E2E8F0" Margin="0,4"/>

                <!-- 指令名稱即時預覽 -->
                <TextBlock Text="生成指令預覽 (Command Preview):" FontSize="11" Foreground="#64748B"/>
                <TextBox x:Name="TxtCommandPreview" IsReadOnly="True" Background="#F1F5F9" Foreground="#0F172A" Height="28" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- 底部按鈕區 -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
            <Button Grid.Column="0" x:Name="BtnRefresh" Content="🔄 重新整理" Height="32" Padding="10,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <Button x:Name="BtnCancel" Content="取消 (Cancel)" Width="90" Height="32" Background="#E2E8F0" Foreground="#334155" HorizontalContentAlignment="Center"/>
                <Button x:Name="BtnNext" Content="下一步：配置參數 (Configure) ➔" Height="32" Padding="14,0" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
