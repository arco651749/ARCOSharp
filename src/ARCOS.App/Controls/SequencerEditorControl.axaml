<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ARCOS.App.Controls.SequencerEditorControl"
             Background="#FFFFFF">

    <UserControl.Resources>
        <!-- ========================================================= -->
        <!-- 全套 Avalonia 11 原生標準向量圖標庫 (拒絕粗糙 Emoji) -->
        <!-- ========================================================= -->
        <StreamGeometry x:Key="IconKey">M12.5 2C10.57 2 9 3.57 9 5.5c0 .54.12 1.05.34 1.51L2 14.35V17h2.65l1.5-1.5H8v-2h1.85l1.64-1.64c.46.22.97.34 1.51.34 1.93 0 3.5-1.57 3.5-3.5S14.43 2 12.5 2zm0 2.5c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1z</StreamGeometry>
        <StreamGeometry x:Key="IconUser">M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm-7 15c0-2.67 5.33-4 7-4s7 1.33 7 4v1H5v-1z</StreamGeometry>
        <StreamGeometry x:Key="IconLock">M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z</StreamGeometry>

        <StreamGeometry x:Key="IconUndo">M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z</StreamGeometry>
        <StreamGeometry x:Key="IconRedo">M18.4 10.6C16.55 8.99 14.15 8 11.5 8c-4.65 0-8.58 3.03-9.96 7.22L3.9 16c1.05-3.19 4.05-5.5 7.6-5.5 1.95 0 3.73.72 5.12 1.88L13 16h9V7l-3.6 3.6z</StreamGeometry>
        <StreamGeometry x:Key="IconRewind">M4 4h2v12H4V4zm2 6l5.5-4v8L6 10zm5.5 0l5.5-4v8l-5.5-4z</StreamGeometry>
        <StreamGeometry x:Key="IconForward">M16 4h-2v12h2V4zm-2 6l-5.5-4v8l5.5-4zm-5.5 0L3 6v8l5.5-4z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronUp">M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronDown">M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>

        <StreamGeometry x:Key="IconFolderLoad">M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
        <StreamGeometry x:Key="IconFloppySave">M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z</StreamGeometry>
        <StreamGeometry x:Key="IconCopyDoc">M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z</StreamGeometry>
        <StreamGeometry x:Key="IconRowAdd">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
        <StreamGeometry x:Key="IconRowMinus">M19 13H5v-2h14v2z</StreamGeometry>
        <StreamGeometry x:Key="IconCross">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>

        <StreamGeometry x:Key="IconPlay">M8 5v14l11-7z</StreamGeometry>
        <StreamGeometry x:Key="IconJump">M5 13h7.17l-3.58 3.59L10 18l6-6-6-6-1.41 1.41L12.17 11H5v2z</StreamGeometry>
        <StreamGeometry x:Key="IconStep">M11 5v7.17l-3.59-3.58L6 10l6 6 6-6-1.41-1.41L13 12.17V5h-2z</StreamGeometry>
        <StreamGeometry x:Key="IconPause">M6 19h4V5H6v14zm8-14v14h4V5h-4z</StreamGeometry>
        <StreamGeometry x:Key="IconReset">M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z</StreamGeometry>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="2">
        <!-- ========================================================= -->
        <!-- 1. 頂部路徑與 Thread / Program 選擇器 + .PROG / .INIT 專案讀存工具列 -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="4,4" Margin="0,0,0,2">
            <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,150" Margin="0,0,0,3">
                    <!-- 腳本名稱 / 路徑顯示條 -->
                    <TextBox x:Name="TxtScriptTitle" Grid.Column="0" Watermark="(No Program Loaded - click READ .PROG)" 
                             FontSize="11" Height="26" VerticalContentAlignment="Center"
                             Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Margin="0,0,4,0"/>
                    
                    <!-- 上下微調按鈕 ▲▼ -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="1" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button x:Name="BtnProgPrev" Width="20" Height="12" Padding="0" 
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1">
                            <Path Data="{StaticResource IconChevronUp}" Fill="#475569" Width="7" Height="7" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnProgNext" Width="20" Height="12" Padding="0" 
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1">
                            <Path Data="{StaticResource IconChevronDown}" Fill="#475569" Width="7" Height="7" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <!-- Thread / Program 下拉切換選單 (預設 Main) -->
                    <ComboBox x:Name="ProgSelector" Grid.Column="2" Height="26" HorizontalAlignment="Stretch" 
                              Background="White" Foreground="#0284C7" FontWeight="Bold" FontSize="11"
                              BorderBrush="#0284C7" BorderThickness="1"/>
                </Grid>

                <!-- PROG & INIT 專用操作工具列 -->
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,1,0,1">
                    <Button x:Name="BtnReadPro" Grid.Column="0" Height="23" Margin="1,0" Padding="4,0"
                            Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="9.5"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="3"
                            ToolTip.Tip="從 ARCOSharp 根目錄讀取 .prog 專案檔">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFolderOpen}" Fill="White" Width="10" Height="10" Stretch="Uniform"/>
                            <TextBlock Text="READ .PROG" FontSize="9.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSavePro" Grid.Column="1" Height="23" Margin="1,0" Padding="4,0"
                            Background="#0369A1" Foreground="White" FontWeight="Bold" FontSize="9.5"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="3"
                            ToolTip.Tip="儲存至 ARCOSharp 根目錄 .prog 專案檔">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFloppySave}" Fill="White" Width="10" Height="10" Stretch="Uniform"/>
                            <TextBlock Text="SAVE .PROG" FontSize="9.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnReadInit" Grid.Column="2" Height="23" Margin="1,0" Padding="4,0"
                            Background="#059669" Foreground="White" FontWeight="Bold" FontSize="9.5"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="3"
                            ToolTip.Tip="從 SCRIPT/ 目錄讀取單一 .init 腳本">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFileCode}" Fill="White" Width="10" Height="10" Stretch="Uniform"/>
                            <TextBlock Text="READ .INIT" FontSize="9.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSaveInit" Grid.Column="3" Height="23" Margin="1,0" Padding="4,0"
                            Background="#047857" Foreground="White" FontWeight="Bold" FontSize="9.5"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="3"
                            ToolTip.Tip="儲存至 SCRIPT/ 目錄 .init 腳本">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFloppySave}" Fill="White" Width="10" Height="10" Stretch="Uniform"/>
                            <TextBlock Text="SAVE .INIT" FontSize="9.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- 2. 主 DataGrid 指令表 (方案 B：高對比現代工控表格) -->
        <!-- ========================================================= -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="2,0,2,2">
            <DataGrid x:Name="GridCommands" AutoGenerateColumns="False" 
                      CanUserResizeColumns="True" CanUserSortColumns="False"
                      Background="White" Foreground="#0F172A"
                      GridLinesVisibility="All" HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0"
                      SelectionMode="Single" RowHeight="22" HeadersVisibility="Column"
                      PointerPressed="OnGridPointerPressed">
                <DataGrid.Styles>
                    <!-- 方案 B 現代 Sky-600 工控標頭 -->
                    <Style Selector="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0284C7"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="BorderBrush" Value="#0369A1"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                        <Setter Property="Fill" Value="Transparent"/>
                    </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                    <!-- 行號 i (專屬指示運行位置 PC，完全獨立於範圍選取) -->
                    <DataGridTemplateColumn Header="i" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Background="Transparent"
                                       PointerPressed="OnCellPointerPressed">
                                    <!-- 運行中：柔和粉色系反白膠囊 (PC 執行指標) -->
                                    <Border IsVisible="{Binding IsCurrentPC}" 
                                            Background="#FFE4E6" BorderBrush="#EF4444" BorderThickness="1.5" 
                                            CornerRadius="3" Margin="2,1">
                                        <TextBlock Text="{Binding LineNumber}" FontWeight="Black" FontSize="11"
                                                   Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- 待命中：一般沉穩灰底透明字 (不受範圍選取影響) -->
                                    <Border IsVisible="{Binding !IsCurrentPC}" 
                                            Background="Transparent" Margin="2,1">
                                        <TextBlock Text="{Binding LineNumber}" FontWeight="SemiBold" FontSize="11"
                                                   Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Panel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Command 指令名稱欄位 (滑鼠左鍵點擊即開啟 Com Select.vi 選單) -->
                    <DataGridTemplateColumn Header="Command" Width="175">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CellBackground}" 
                                        BorderBrush="{Binding CellBorderBrush}" 
                                        BorderThickness="{Binding CellBorderThickness}" 
                                        CornerRadius="2" Margin="1,0"
                                        Padding="4,0" Cursor="Hand"
                                        PointerPressed="OnCommandCellPointerPressed">
                                    <TextBlock Text="{Binding Command}" 
                                               Foreground="#003399" FontWeight="SemiBold" FontSize="11"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Parameters 參數欄位 (滑鼠左鍵雙擊即開啟 Parameter.vi 導引視窗) -->
                    <DataGridTemplateColumn Header="Parameters" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CellBackground}" 
                                        BorderBrush="{Binding CellBorderBrush}" 
                                        BorderThickness="{Binding CellBorderThickness}" 
                                        CornerRadius="2" Margin="1,0"
                                        Padding="4,0" Cursor="Hand"
                                        DoubleTapped="OnParameterCellDoubleTapped"
                                        PointerPressed="OnParameterCellPointerPressed">
                                    <TextBlock Text="{Binding Parameter}" 
                                               Foreground="#222222" FontSize="11"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ========================================================= -->
        <!-- 3. 搜尋過濾條 (可隱藏，按 🔍 展開) -->
        <!-- ========================================================= -->
        <Border x:Name="SearchPanel" Grid.Row="2" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="3"
                Padding="6,3" Margin="2,0,2,2" IsVisible="False">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="Find:" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#78350F" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtSearchKeyword" Grid.Column="1" Height="22" FontSize="11" VerticalContentAlignment="Center" Background="White" Margin="0,0,4,0"/>
                <TextBlock x:Name="TxtSearchStatus" Grid.Column="2" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7" Margin="4,0,8,0"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="0,0,4,0">
                    <Button x:Name="BtnFindPrev" Width="22" Height="22" Padding="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" ToolTip.Tip="尋找上一個 (Shift+Enter)">
                        <Path Data="{StaticResource IconChevronUp}" Fill="#475569" Width="9" Height="9" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnFindNext" Width="22" Height="22" Padding="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" ToolTip.Tip="尋找下一個 (Enter)">
                        <Path Data="{StaticResource IconChevronDown}" Fill="#475569" Width="9" Height="9" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
                <Button x:Name="BtnCloseSearch" Grid.Column="4" Width="20" Height="20" Padding="0"
                        Background="Transparent" BorderThickness="0" ToolTip.Tip="關閉搜尋">
                    <Path Data="{StaticResource IconClose}" Fill="#64748B" Width="8" Height="8" Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- 4. 方案 B：現代精緻工控雙頁籤控制台 (OPERATOR / SUPERVISOR) -->
        <!-- ========================================================= -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="2,1">
            <Grid RowDefinitions="Auto,*">
                <!-- 頂部 Segmented 角色切換膠囊 (極簡現代 Pill Bar) -->
                <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="4" Margin="4,4,4,2" Padding="2">
                    <Grid ColumnDefinitions="*,*">
                        <Button x:Name="BtnTabOp" Grid.Column="0" Height="24" CornerRadius="3"
                                Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Click="OnTabOpClick">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconKey}" Fill="#0284C7" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="OPERATOR" FontWeight="Bold" FontSize="11" Foreground="#0284C7" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnTabSup" Grid.Column="1" Height="24" CornerRadius="3"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Click="OnTabSupClick">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconUser}" Fill="#64748B" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="SUPERVISOR" FontWeight="SemiBold" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ==================== 頁籤 1: OPERATOR 面板 ==================== -->
                <Border x:Name="PnlOperator" Grid.Row="1" Padding="6,4,6,6" IsVisible="True">
                    <Grid RowDefinitions="Auto,Auto">
                        <!-- 第一列：ActiveMode 與 鎖定鈕 -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                            <CheckBox x:Name="ChkActiveModeOp" Grid.Column="0" Content="ActiveMode" IsChecked="True" 
                                      FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Button x:Name="BtnLockOp" Grid.Column="1" HorizontalAlignment="Right" Width="26" Height="22" Padding="0"
                                    Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" ToolTip.Tip="鎖定狀態">
                                <Path Data="{StaticResource IconLock}" Fill="#64748B" Width="11" Height="11" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <!-- 第二列：小文件鍵 + 大顆 Run + 即時動態狀態看板 (IDLE) -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" Margin="0,1">
                            <Button x:Name="BtnDocOp" Grid.Column="0" Width="28" Height="46" Margin="0,0,6,0"
                                    Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" ToolTip.Tip="讀取專案檔 (.prog) [Operator 快速載入]">
                                <Path Data="{StaticResource IconFolderOpen}" Fill="#0284C7" Width="13" Height="13" Stretch="Uniform"/>
                            </Button>

                            <Button x:Name="BtnBigRunOp" Grid.Column="1" Width="78" Height="46" Margin="0,0,8,0"
                                    Background="#0284C7" BorderThickness="0" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform"/>
                                    <TextBlock Text="Run" FontWeight="Black" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 現代光學即時狀態看板 (含 LED 呼吸狀態燈) -->
                            <Border x:Name="PnlStatusBillboard" Grid.Column="2" Height="46"
                                    Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse x:Name="LedModernStatus" Width="11" Height="11" Fill="#94A3B8"/>
                                    <TextBlock x:Name="TxtMachineStatus" Text="IDLE" 
                                               FontWeight="Black" FontSize="22" LetterSpacing="2" Foreground="#334155" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ==================== 頁籤 2: SUPERVISOR 面板 ==================== -->
                <Border x:Name="PnlSupervisor" Grid.Row="1" Padding="4,4,4,6" IsVisible="False">
                    <Grid ColumnDefinitions="28,*" Margin="0">
                        <!-- 左側垂直雙按鈕 (鎖定 + 關閉) -->
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0" VerticalAlignment="Center">
                            <Button x:Name="BtnLockSup" Width="26" Height="24" Padding="0" 
                                    Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" ToolTip.Tip="鎖定">
                                <Path Data="{StaticResource IconLock}" Fill="#64748B" Width="11" Height="11" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="BtnCrossSup" Width="26" Height="24" Padding="0" 
                                    Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="3" ToolTip.Tip="中止">
                                <Path Data="{StaticResource IconCross}" Fill="#EF4444" Width="11" Height="11" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <!-- 右側主除錯工具陣列 (三列對齊佈局) -->
                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" Margin="0">
                            <!-- 第一行：ActiveMode + 導航 (Git, |<<, >>|, 搜尋, 重整, Load) -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                                <CheckBox x:Name="ChkActiveModeSup" Grid.Column="0" Content="ActiveMode" IsChecked="True" 
                                          FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                                    <Button x:Name="BtnGit" Height="22" Padding="6,0" 
                                            Foreground="#0284C7" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="2"
                                            ToolTip.Tip="比對目前 .prog 與 Git 上一個版本之差異 (Git Diff &amp; Reload)">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Path Data="{StaticResource IconFileCode}" Fill="#0284C7" Width="10" Height="10" Stretch="Uniform"/>
                                            <TextBlock Text="Git Diff" FontSize="10" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnUndo" Width="24" Height="22" Padding="0" 
                                            Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" ToolTip.Tip="復原 (Undo)">
                                        <Path Data="{StaticResource IconUndo}" Fill="#475569" Width="11" Height="11" Stretch="Uniform"/>
                                    </Button>
                                    <Button x:Name="BtnRedo" Width="24" Height="22" Padding="0" 
                                            Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" ToolTip.Tip="重做 (Redo)">
                                        <Path Data="{StaticResource IconRedo}" Fill="#475569" Width="11" Height="11" Stretch="Uniform"/>
                                    </Button>
                                    <Button x:Name="BtnSearch" Width="24" Height="22" Padding="0" 
                                            Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" ToolTip.Tip="關鍵字搜尋 (Search)">
                                        <Path Data="{StaticResource IconSearch}" Fill="#0284C7" Width="10" Height="10" Stretch="Uniform"/>
                                    </Button>
                                    <Button x:Name="BtnRefresh" Width="24" Height="22" Padding="0" 
                                            Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" ToolTip.Tip="重新整理">
                                        <Path Data="{StaticResource IconRefresh}" Fill="#10B981" Width="10" Height="10" Stretch="Uniform"/>
                                    </Button>
                                    <Button x:Name="BtnLoad" Height="22" Padding="6,0" 
                                            Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="2">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Path Data="{StaticResource IconFolderLoad}" Fill="#0284C7" Width="10" Height="10" Stretch="Uniform"/>
                                            <TextBlock Text="Load" FontSize="10" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 第二行：中型 Run + 行增刪 (存行, 刪行-, 加行+, 清空x, Save) -->
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                                <Button x:Name="BtnRunSup" Grid.Column="0" Width="68" Height="26" 
                                        Background="#0284C7" BorderThickness="0" CornerRadius="3">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform"/>
                                        <TextBlock Text="Run" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                                    <Button x:Name="BtnSaveLine" Width="26" Height="26" Padding="0" 
                                            Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" ToolTip.Tip="儲存修改">
                                        <Path Data="{StaticResource IconFloppySave}" Fill="#475569" Width="11" Height="11" Stretch="Uniform"/>
                                    </Button>
                                    <Button x:Name="BtnMinusLine" Width="26" Height="26" Padding="0" 
                                            Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="2" ToolTip.Tip="刪除所選行">
                                        <Rectangle Width="11" Height="2" Fill="#EF4444" RadiusX="0.5" RadiusY="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="BtnAdd" Width="26" Height="26" Padding="0" 
                                            Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="2" ToolTip.Tip="在所選位置插入新行 (同 Ctrl+Click)">
                                        <Path Data="{StaticResource IconRowAdd}" Fill="#10B981" Width="11" Height="11" Stretch="Uniform"/>
                                    </Button>
                                    <Button x:Name="BtnDelete" Width="26" Height="26" Padding="0" 
                                            Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="2" ToolTip.Tip="清空當前程式區 (Clear Section)">
                                        <Path Data="{StaticResource IconCross}" Fill="#EF4444" Width="11" Height="11" Stretch="Uniform"/>
                                    </Button>
                                    <Button x:Name="BtnSave" Height="26" Padding="6,0" 
                                            Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="2">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Path Data="{StaticResource IconFloppySave}" Fill="#0284C7" Width="11" Height="11" Stretch="Uniform"/>
                                            <TextBlock Text="Save" FontSize="10.5" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 第三行：流程單步控制 5 等分欄 (Auto, Jump, Step, Pause, Reset，全原生向量圖標) -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*" Margin="0">
                                <Button x:Name="BtnAuto" Grid.Column="0" Margin="1,0" Height="26" 
                                        Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconPlay}" Fill="#0284C7" Width="9" Height="9" Stretch="Uniform"/>
                                        <TextBlock Text="Auto" FontWeight="Bold" FontSize="10.5" Foreground="#0284C7"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnJump" Grid.Column="1" Margin="1,0" Height="26" 
                                        Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconJump}" Fill="#334155" Width="10" Height="10" Stretch="Uniform"/>
                                        <TextBlock Text="Jump" FontWeight="Bold" FontSize="10.5" Foreground="#334155"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStep" Grid.Column="2" Margin="1,0" Height="26" 
                                        Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconStep}" Fill="#10B981" Width="10" Height="10" Stretch="Uniform"/>
                                        <TextBlock Text="Step" FontWeight="Bold" FontSize="10.5" Foreground="#10B981"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnPause" Grid.Column="3" Margin="1,0" Height="26" 
                                        Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconPause}" Fill="#0284C7" Width="9" Height="9" Stretch="Uniform"/>
                                        <TextBlock Text="Pause" FontWeight="Bold" FontSize="10.5" Foreground="#0284C7"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnReset" Grid.Column="4" Margin="1,0" Height="26" 
                                        Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconReset}" Fill="#10B981" Width="10" Height="10" Stretch="Uniform"/>
                                        <TextBlock Text="Reset" FontWeight="Bold" FontSize="10.5" Foreground="#10B981"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>