<Window xmlns="https://github.com/avaloniaui"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:controls="clr-namespace:ARCOS.App.Controls"

        xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:studio="clr-namespace:ARCOS.CsviStudio.Controls;assembly=CSVI_Studio"

        x:Class="ARCOS.App.MainWindow"

        Title="ARCOS Automated Machine Controller (.NET 8 Avalonia - Win &amp; Linux)" 

        Width="1280" Height="820" MinWidth="1024" MinHeight="700"

        RequestedThemeVariant="Light"

        Background="#F1F5F9" WindowStartupLocation="CenterScreen">



    <Grid RowDefinitions="*">

        <!-- 核心 10 大分頁導覽列 (方案 B 現代工控風：全寬等距均分 UniformGrid，預設聚焦 Capture) -->

        <TabControl x:Name="MainTabControl" Grid.Row="0" TabStripPlacement="Bottom" Classes="modern-industrial-bottom" Background="#F1F5F9" Margin="0" Padding="0" SelectedIndex="1">

            <!-- 關鍵：利用 UniformGrid Rows="1" 讓 10 個分頁在底部完全平均等距鋪滿 100% 寬度 -->

            <TabControl.ItemsPanel>

                <ItemsPanelTemplate>

                    <UniformGrid Rows="1" HorizontalAlignment="Stretch"/>

                </ItemsPanelTemplate>

            </TabControl.ItemsPanel>



            <TabControl.Styles>

                <Style Selector="TabControl.modern-industrial-bottom TabItem">

                    <Setter Property="Height" Value="26"/>

                    <Setter Property="MinHeight" Value="26"/>

                    <Setter Property="MaxHeight" Value="26"/>

                    <Setter Property="Padding" Value="2,0"/>

                    <Setter Property="Margin" Value="0"/>

                    <Setter Property="FontSize" Value="11"/>

                    <Setter Property="FontWeight" Value="SemiBold"/>

                    <Setter Property="VerticalContentAlignment" Value="Center"/>

                    <Setter Property="HorizontalContentAlignment" Value="Center"/>

                    <Setter Property="Foreground" Value="#475569"/>

                    <Setter Property="Background" Value="#E2E8F0"/>

                    <Setter Property="BorderBrush" Value="#CBD5E1"/>

                    <Setter Property="BorderThickness" Value="0,1,1,0"/>

                    <Setter Property="HorizontalAlignment" Value="Stretch"/>

                </Style>

                <Style Selector="TabControl.modern-industrial-bottom TabItem /template/ ContentPresenter#PART_ContentPresenter">

                    <Setter Property="MinHeight" Value="0"/>

                    <Setter Property="Padding" Value="0"/>

                    <Setter Property="HorizontalAlignment" Value="Stretch"/>

                    <Setter Property="HorizontalContentAlignment" Value="Center"/>

                </Style>

                <Style Selector="TabControl.modern-industrial-bottom TabItem:pointerover">

                    <Setter Property="Background" Value="#F8FAFC"/>

                    <Setter Property="Foreground" Value="#0F172A"/>

                </Style>

                <Style Selector="TabControl.modern-industrial-bottom TabItem:selected">

                    <Setter Property="Foreground" Value="#0284C7"/>

                    <Setter Property="Background" Value="#FFFFFF"/>

                    <Setter Property="FontWeight" Value="Bold"/>

                    <Setter Property="BorderBrush" Value="#0284C7"/>

                    <Setter Property="BorderThickness" Value="0,2,1,0"/>

                </Style>

            </TabControl.Styles>



            <!-- ========================================================= -->

            <!-- 1. USER TAB (作業員與產線主畫面：左畫布+急停日誌，右常駐 Sequencer) -->

            <!-- ========================================================= -->

            <TabItem x:Name="TabUser" Header="User Tab">

                <Grid ColumnDefinitions="*,460" Margin="4">

                    <!-- 左側主工作區 (70%) -->

                    <Grid Grid.Column="0" RowDefinitions="*,90" Margin="0,0,4,0">

                        <!-- 上半部：User Front Panel 動態自訂畫布 -->

                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,4" CornerRadius="6" Padding="6">
                            <ContentControl x:Name="UserFrontPanelContainer" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="32,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🖥️ [ USER FRONT PANEL SUBPANEL ]" FontWeight="Black" FontSize="16" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                        <TextBlock Text="尚未載入自訂使用者介面 (No User Panel Loaded)" Foreground="#64748B" FontSize="13" HorizontalAlignment="Center"/>
                                        <TextBlock Text="請於腳本下達指令：System@UserPanelOpen, UserPanel.csvi" FontFamily="Consolas" Foreground="#0284C7" HorizontalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </ContentControl>
                        </Border>

                        <!-- 下半部：方案 B 現代精緻工控底欄 (PAUSE、急停 STOP、OK 狀態膠囊與終端日誌) -->

                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,6">

                            <Grid ColumnDefinitions="Auto,*">

                                <!-- 左側緊急控制與燈號膠囊 -->

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,10,0">

                                    <!-- 方案 B 現代藍調 PAUSE 按鈕 -->

                                    <Button x:Name="BtnUserPause" Width="105" Height="46" 

                                            Background="#F0F9FF" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="4">

                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">

                                            <TextBlock Text="⏸" FontSize="15" Foreground="#0284C7" VerticalAlignment="Center"/>

                                            <TextBlock Text="PAUSE" FontWeight="Black" FontSize="13" Foreground="#0284C7" VerticalAlignment="Center"/>

                                        </StackPanel>

                                    </Button>



                                    <!-- 方案 B 工業純色高對比 !!STOP!! 急停按鈕 (現代深紅告警) -->

                                    <Button x:Name="BtnUserStop" Width="125" Height="46" 

                                            Background="#EF4444" BorderBrush="#DC2626" BorderThickness="1.5" CornerRadius="4">

                                        <TextBlock Text="!! STOP !!" FontWeight="Black" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    </Button>



                                    <!-- 方案 B 現代精緻 OK 狀態燈號膠囊 (微邊框 + 綠色呼吸 LED) -->

                                    <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Height="46" Padding="10,0">

                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">

                                            <Ellipse x:Name="LedUserOk" Width="14" Height="14" Fill="#10B981" Stroke="#059669" StrokeThickness="1.5"/>

                                            <StackPanel VerticalAlignment="Center" Spacing="1">

                                                <TextBlock Text="SYSTEM" FontSize="8.5" FontWeight="SemiBold" Foreground="#047857"/>

                                                <TextBlock Text="READY" FontWeight="Black" FontSize="11" Foreground="#065F46"/>

                                            </StackPanel>

                                        </StackPanel>

                                    </Border>

                                </StackPanel>



                                <!-- 右側即時滾動終端日誌 (Sunken Slate-50) -->

                                <TextBox x:Name="TxtUserLogs" Grid.Column="1" Background="#F8FAFC" Foreground="#1E293B"

                                         FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" IsReadOnly="True" 

                                         BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,4"

                                         ScrollViewer.VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>

                            </Grid>

                        </Border>

                    </Grid>



                    <!-- 右側常駐 Sequencer 側邊欄 (30%) -->

                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">

                        <controls:SequencerEditorControl x:Name="SequencerEditor"/>

                    </Border>

                </Grid>

            </TabItem>



            <!-- ========================================================= -->

            <!-- 2. CAPTURE (視覺相機多工位、打光對位、無限 IO 虛擬化與 4 大運動控制) -->

            <!-- ========================================================= -->

            <TabItem x:Name="TabCapture" Header="Capture">

                <Grid RowDefinitions="Auto,*" Margin="4">

                    <!-- 上方相機分頁 (CAM0 ~ CAM11) -->

                    



                    <!-- 下方主內容區：第 1 欄硬體/指令 (150px)，第 2 欄無限 IO (235px)，第 3 欄影像與運動 (*) -->

                    <Grid Grid.Row="1" ColumnDefinitions="150,235,*">

                        <!-- 第 1 欄：硬體快捷清單、ROI STRING 與 CaptureCMD 快速指令 -->

                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,4,0">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">

                                <StackPanel Spacing="6">

                                    <!-- CamList 與 Snap 按鈕並排 (原版配置) -->

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">

                                        <TextBlock Text="CamList" FontWeight="Bold" FontSize="11" Foreground="#334155" VerticalAlignment="Center"/>

                                        <Button x:Name="BtnCaptureSnap" Grid.Column="1" Content="Snap" Width="50" Height="22" 

                                                Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="10.5" CornerRadius="3"

                                                ToolTip.Tip="單幀取像 Snap (Capture@UpdateImage)"/>

                                    </Grid>

                                    <ListBox x:Name="LstCaptureCameras" Height="280" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"/>



                                    <!-- ROI STRING 設定與即時回饋 (雙向綁定) -->

                                    <TextBlock Text="ROI STRING" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,4,0,0"/>

                                    <TextBox x:Name="TxtRoiString" Text="Rect(100,100,400,300)" Height="52" FontSize="10.5" 

                                             AcceptsReturn="True" TextWrapping="Wrap"

                                             Background="#F8FAFC" BorderBrush="#CBD5E1"

                                             KeyUp="OnRoiStringKeyUp"/>



                                    <!-- MotorList for IMAQ -->

                                    <TextBlock Text="MotorList For IMAQ" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,4,0,0"/>

                                    <ListBox x:Name="LstCaptureMotors" Height="280" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"/>

                                </StackPanel>

                            </ScrollViewer>

                        </Border>



                        <!-- 第 2 欄：無限 IO 虛擬化點位監視與控制面板 (快速搜尋選單 + 虛擬滾動列表) -->

                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="5" Margin="0,0,4,0">

                            <Grid RowDefinitions="Auto,*">

                                <!-- 頂部：快速過濾／搜尋選單 (整欄寬度) -->

                                <ComboBox x:Name="CmbIoFilter" Grid.Row="0" Height="24" Margin="0,0,0,4" HorizontalAlignment="Stretch"

                                          Background="White" BorderBrush="#CBD5E1" FontSize="10.5"

                                          SelectedIndex="0" SelectionChanged="OnIoFilterChanged">

                                    <ComboBoxItem Content="All IO (512 Points + Virtual)"/>

                                    <ComboBoxItem Content="Virtual IOs (TRUE / FALSE)"/>

                                    <ComboBoxItem Content="P0.* (Bit 0~7)"/>

                                    <ComboBoxItem Content="P1.* (Bit 0~7)"/>

                                    <ComboBoxItem Content="P2.* (Bit 0~7)"/>

                                    <ComboBoxItem Content="P3.* (Bit 0~7)"/>

                                    <ComboBoxItem Content="P0.* ~ P7.* (Bank 0: 64 pts)"/>

                                    <ComboBoxItem Content="P8.* ~ P15.* (Bank 1: 64 pts)"/>

                                    <ComboBoxItem Content="P16.* ~ P31.* (Bank 2: 128 pts)"/>

                                    <ComboBoxItem Content="P32.* ~ P63.* (Bank 3: 256 pts)"/>

                                </ComboBox>



                                <!-- 無限點位虛擬化列表 (滾動條恆常顯示，三大子元件完全獨立解耦) -->

                                <ListBox x:Name="LstIoChannels" Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"

                                         Padding="1" 

                                         ScrollViewer.VerticalScrollBarVisibility="Visible"

                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                                         ScrollViewer.AllowAutoHide="False">

                                    <ListBox.Styles>

                                        <Style Selector="ListBoxItem">

                                            <!-- 右側預留 20px 給常駐滾動條，確保 Boolean 按鈕與滾動條間距充足，絕不受遮擋 -->

                                            <Setter Property="Padding" Value="1,1,20,1"/>

                                            <Setter Property="MinHeight" Value="24"/>

                                            <Setter Property="Margin" Value="0,0"/>

                                        </Style>

                                        <!-- 徹底關閉 ListBoxItem 的 hover 變色反白，維持純色工控靜態背景 -->

                                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">

                                            <Setter Property="Background" Value="Transparent"/>

                                        </Style>

                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">

                                            <Setter Property="Background" Value="Transparent"/>

                                        </Style>

                                    </ListBox.Styles>

                                    <ListBox.ItemTemplate>

                                        <DataTemplate>

                                            <!-- 單組 IO 點位列：左側 Port 標籤、中間獨立 PortName 文字框、右側獨立 22x22 方形 Boolean 按鈕 -->

                                            <Grid ColumnDefinitions="44,*,22" Height="22" IsVisible="{Binding IsVisible}" Margin="0,1">

                                                <!-- 1. PORT 位址標籤 (例如 P0.0, TRUE, FALSE，獨立卡片) -->

                                                <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Margin="0,0,2,0">

                                                    <TextBlock Text="{Binding Port}" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7"

                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                </Border>



                                                <!-- 2. PORTNAME 獨立文字方塊 (自帶完整外框與邊距，文字絕不溢出或被蓋過) -->

                                                <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" 

                                                         Height="22" MinHeight="22" FontSize="10" Padding="5,2" Margin="0,0,2,0"

                                                         Background="White" Foreground="#1E293B" 

                                                         BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2"

                                                         VerticalContentAlignment="Center"/>



                                                <!-- 3. 方形 BOOLEAN 按鈕：自訂 ControlTemplate 拔除 FluentTheme 懸浮 (pointerover) 反白變白特效，恆常保持 StateBrush 原色 -->

                                                <Button Grid.Column="2" Width="22" Height="22" Padding="0" Cursor="Hand"

                                                        Background="{Binding StateBrush}"

                                                        Click="OnIoBitToggleClick" Tag="{Binding Port}"

                                                        AutomationProperties.Name="{Binding AutomationId}"

                                                        ToolTip.Tip="點擊切換輸出高低電位 (BOOLEAN)">

                                                    <Button.Template>

                                                        <ControlTemplate TargetType="Button">

                                                            <Border Background="{TemplateBinding Background}" 

                                                                    BorderBrush="#64748B" BorderThickness="1" CornerRadius="2"

                                                                    Width="22" Height="22"/>

                                                        </ControlTemplate>

                                                    </Button.Template>

                                                </Button>

                                            </Grid>

                                        </DataTemplate>

                                    </ListBox.ItemTemplate>

                                </ListBox>

                            </Grid>

                        </Border>



                        <!-- 第 3 欄：中央視窗 + 坐標回饋 + 底部 4 大 MOTION 面板 -->

                        <Grid Grid.Column="2" RowDefinitions="*,200">

                            <!-- 上半部：中央視覺檢驗視窗 (NI VDM 浮動工具列 + 坐標轉換回饋) -->

                            <Border Grid.Row="0" Background="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">

                                <Grid>

                                    <!-- 影像本體 (含滑鼠移動與點擊選位監聽) -->

                                    <Image x:Name="ImgLivePreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"

                                           PointerMoved="OnImagePointerMoved" PointerPressed="OnImagePointerPressed"/>



                                    <!-- NI VDM 繪圖量測輔助工具列 (左側懸浮) -->

                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" 

                                                Background="#FFFFFF" Margin="6" Spacing="2" Opacity="0.95">

                                        <Button x:Name="BtnToolZoom" Width="26" Height="24" Padding="0" ToolTip.Tip="Zoom 縮放" Click="OnToolSelected" Tag="Zoom">

                                            <Path Data="{StaticResource IconZoomIn}" Fill="#334155" Width="13" Height="13" Stretch="Uniform"/>

                                        </Button>

                                        <Button x:Name="BtnToolPan" Width="26" Height="24" Padding="0" ToolTip.Tip="Pan 拖曳平移" Click="OnToolSelected" Tag="Pan">

                                            <Path Data="{StaticResource IconHand}" Fill="#334155" Width="13" Height="13" Stretch="Uniform"/>

                                        </Button>

                                        <Button x:Name="BtnToolLine" Width="26" Height="24" Padding="0" ToolTip.Tip="Line 直線量測" Click="OnToolSelected" Tag="Line">

                                            <Path Data="{StaticResource IconRuler}" Fill="#334155" Width="13" Height="13" Stretch="Uniform"/>

                                        </Button>

                                        <Button x:Name="BtnToolRect" Width="26" Height="24" Padding="0" ToolTip.Tip="Rect 正矩形" Click="OnToolSelected" Tag="Rect">

                                            <Path Data="{StaticResource IconSquareOutline}" Fill="#334155" Width="13" Height="13" Stretch="Uniform"/>

                                        </Button>

                                        <Button x:Name="BtnToolRotRect" Width="26" Height="24" Padding="0" ToolTip.Tip="RotatedRect 旋轉矩形" Click="OnToolSelected" Tag="RotatedRect">

                                            <Path Data="{StaticResource IconBoxSelect}" Fill="#334155" Width="13" Height="13" Stretch="Uniform"/>

                                        </Button>

                                        <Button x:Name="BtnToolCircle" Width="26" Height="24" Padding="0" ToolTip.Tip="Circle 圓形" Click="OnToolSelected" Tag="Circle">

                                            <Path Data="{StaticResource IconCircleOutline}" Fill="#334155" Width="13" Height="13" Stretch="Uniform"/>

                                        </Button>

                                        <Button x:Name="BtnToolAnnulus" Width="26" Height="24" Padding="0" ToolTip.Tip="Annulus 圓環" Click="OnToolSelected" Tag="Annulus">

                                            <Path Data="{StaticResource IconDisc}" Fill="#334155" Width="13" Height="13" Stretch="Uniform"/>

                                        </Button>

                                        <Button x:Name="BtnToolCrosshair" Width="26" Height="24" Padding="0" ToolTip.Tip="Crosshair 十字靶心" Click="OnToolSelected" Tag="Crosshair">

                                            <Path Data="{StaticResource IconCrosshair}" Fill="#334155" Width="13" Height="13" Stretch="Uniform"/>

                                        </Button>

                                    </StackPanel>



                                    <!-- 底部座標回饋列 (IMAQSelectPoint 點選選位 + IMAQPosition 即時座標) -->

                                    <Border VerticalAlignment="Bottom" Background="#1E293B" Opacity="0.92" Padding="8,4">

                                        <DockPanel LastChildFill="True">

                                            <!-- IMAQSelectPoint (滑鼠點擊鎖定物理位置) -->

                                            <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Left" VerticalAlignment="Center">

                                                <TextBlock Text="IMAQSelectPoint:" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>

                                                <TextBox x:Name="TxtImaqSelectPoint" Text="[None]" Height="22" FontSize="11" Padding="4,1"

                                                         IsReadOnly="True" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#0284C7"/>

                                            </StackPanel>



                                            <!-- IMAQPosition (即時換算物理 mm 座標，無校正秀 Pixel) -->

                                            <TextBlock x:Name="TxtImaqPosition" Text="IMAQPosition: (0.000, 0.000) [Uncalibrated px]" 

                                                       FontSize="11" FontWeight="Bold" Foreground="#10B981" 

                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        </DockPanel>

                                    </Border>

                                </Grid>

                            </Border>



                            <!-- 下半部：MOTION 4 大核心功能模組化面板 (JOG / GO / GOPOINT / GOPALLET + 7 軸 DRO) -->

                            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6">

                                <TabControl Background="#FFFFFF" Padding="0">

                                    <!-- 1. Motion 主控制子頁 -->

                                    <TabItem Header="Motion" FontSize="11" FontWeight="Bold">

                                        <Grid RowDefinitions="*,Auto" Margin="2">

                                            <!-- 上部：4 大功能卡片並排 -->

                                            <Grid Grid.Row="0" ColumnDefinitions="90,1.3*,1.3*,1.4*" Margin="0,0,0,4">

                                                <!-- 功能卡片 1：狀態與馬達 (Running LED + IMAQMotor) -->

                                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,3,0">

                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">

                                                        <Ellipse x:Name="LedMotionRunning" Width="22" Height="22" Fill="#10B981" Stroke="#059669" StrokeThickness="1.5"/>

                                                        <TextBlock Text="RUNNING" FontSize="9" FontWeight="Black" Foreground="#047857" HorizontalAlignment="Center"/>

                                                        <TextBlock Text="IMAQMotor" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>

                                                    </StackPanel>

                                                </Border>



                                                <!-- 功能卡片 2：JOG (寸動手動微步控制) -->

                                                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="3,0">

                                                    <Grid RowDefinitions="Auto,Auto,Auto">

                                                        <TextBlock Grid.Row="0" Text="1. JOG (寸動手動控制)" FontWeight="Bold" FontSize="10.5" Foreground="#0284C7" Margin="0,0,0,3"/>

                                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*" Margin="0,0,0,4">

                                                            <TextBlock Grid.Column="0" Text="Axis:" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,3,0"/>

                                                            <ComboBox x:Name="CmbJogAxis" Grid.Column="1" Height="22" FontSize="10" SelectedIndex="0" Background="White" BorderBrush="#CBD5E1">

                                                                <ComboBoxItem Content="XYZ"/>

                                                                <ComboBoxItem Content="X"/>

                                                                <ComboBoxItem Content="Y"/>

                                                                <ComboBoxItem Content="Z"/>

                                                            </ComboBox>

                                                            <TextBlock Grid.Column="2" Text="Step:" FontSize="10.5" VerticalAlignment="Center" Margin="4,0,3,0"/>

                                                            <ComboBox x:Name="CmbJogStep" Grid.Column="3" Height="22" FontSize="10" SelectedIndex="2" Background="White" BorderBrush="#CBD5E1">

                                                                <ComboBoxItem Content="0.01"/>

                                                                <ComboBoxItem Content="0.10"/>

                                                                <ComboBoxItem Content="1.00"/>

                                                                <ComboBoxItem Content="10.00"/>

                                                            </ComboBox>

                                                        </Grid>

                                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">

                                                            <Button x:Name="BtnJogMinus" Content="&lt;&lt;--" Width="44" Height="24" FontSize="10" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" CornerRadius="2"/>

                                                            <Button x:Name="BtnGetPos" Content="GetPos" Width="50" Height="24" FontSize="10" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" CornerRadius="2"/>

                                                            <Button x:Name="BtnJogPlus" Content="++&gt;&gt;" Width="44" Height="24" FontSize="10" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" CornerRadius="2"/>

                                                        </StackPanel>

                                                    </Grid>

                                                </Border>



                                                <!-- 功能卡片 3：GO (定位運動) -->

                                                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="3,0">

                                                    <Grid RowDefinitions="Auto,Auto,Auto">

                                                        <TextBlock Grid.Row="0" Text="2. GO (目標定位運動)" FontWeight="Bold" FontSize="10.5" Foreground="#0284C7" Margin="0,0,0,3"/>

                                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*" Margin="0,0,0,4">

                                                            <TextBlock Grid.Column="0" Text="Spd:" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,3,0"/>

                                                            <TextBox x:Name="TxtMotionSpeed" Grid.Column="1" Text="20.0" Height="22" FontSize="10" Background="White" BorderBrush="#CBD5E1"/>

                                                            <TextBlock Grid.Column="2" Text="Axis:" FontSize="10.5" VerticalAlignment="Center" Margin="4,0,3,0"/>

                                                            <ComboBox x:Name="CmbMotionAxis" Grid.Column="3" Height="22" FontSize="10" SelectedIndex="0" Background="White" BorderBrush="#CBD5E1">

                                                                <ComboBoxItem Content="XYZ"/>

                                                                <ComboBoxItem Content="XY"/>

                                                                <ComboBoxItem Content="Z"/>

                                                            </ComboBox>

                                                        </Grid>

                                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">

                                                            <TextBox x:Name="TxtMotionTarget" Grid.Column="0" Text="0.0, 0.0, 0.0" Height="24" FontSize="10" Background="White" BorderBrush="#CBD5E1" Margin="0,0,4,0"/>

                                                            <Button x:Name="BtnMotionGo" Grid.Column="1" Width="46" Height="24" Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="10" CornerRadius="2" Margin="0,0,3,0">

                                                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">

                                                                    <Path Data="{StaticResource IconPlay}" Fill="White" Width="9" Height="9" Stretch="Uniform"/>

                                                                    <TextBlock Text="Go" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>

                                                                </StackPanel>

                                                            </Button>

                                                            <Button x:Name="BtnMotionStop" Grid.Column="2" Width="48" Height="24" Background="#EF4444" Foreground="White" FontWeight="Bold" FontSize="10" CornerRadius="2">

                                                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">

                                                                    <Path Data="{StaticResource IconStop}" Fill="White" Width="9" Height="9" Stretch="Uniform"/>

                                                                    <TextBlock Text="Stop" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>

                                                                </StackPanel>

                                                            </Button>

                                                        </Grid>

                                                    </Grid>

                                                </Border>



                                                <!-- 功能卡片 4：GOPOINT & GOPALLET (點位與料盤跳轉) -->

                                                <Border Grid.Column="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="3,0,0,0">

                                                    <Grid RowDefinitions="Auto,Auto,Auto">

                                                        <TextBlock Grid.Row="0" Text="3. GOPOINT &amp; GOPALLET" FontWeight="Bold" FontSize="10.5" Foreground="#0284C7" Margin="0,0,0,3"/>

                                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">

                                                            <ComboBox x:Name="CmbMotionPoints" Grid.Column="0" Height="22" FontSize="10" Background="White" BorderBrush="#CBD5E1" Margin="0,0,3,0"

                                                                      SelectionChanged="OnMotionPointSelectionChanged"/>

                                                            <Button x:Name="BtnGoPoint" Grid.Column="1" Content="Go Point" Width="58" Height="22" Background="#0284C7" Foreground="White" FontSize="10" FontWeight="Bold" CornerRadius="2" Margin="0,0,2,0"/>

                                                            <Button x:Name="BtnGoPallet" Grid.Column="2" Content="Go Pallet" Width="58" Height="22" Background="#0284C7" Foreground="White" FontSize="10" FontWeight="Bold" CornerRadius="2"/>

                                                        </Grid>

                                                        <!-- 預選點位 7 軸坐標即時預覽 -->

                                                        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="4,2">

                                                            <TextBlock x:Name="TxtTargetPointCoords" Text="Target: X 100.0 Y 200.0 Z -50.0" FontSize="9.5" Foreground="#475569" TextTrimming="CharacterEllipsis"/>

                                                        </Border>

                                                    </Grid>

                                                </Border>

                                            </Grid>



                                            <!-- 下部：7 軸即時坐標數位讀表看板 (DRO, Digital Readout) -->

                                            <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="3" Padding="8,4">

                                                <Grid ColumnDefinitions="*,*,*,*,*,*,*">

                                                    <TextBlock Grid.Column="0" x:Name="TxtDroX" Text="X: 000.000" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1" x:Name="TxtDroY" Text="Y: 000.000" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2" x:Name="TxtDroZ" Text="Z: 000.000" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Center"/>

                                                    <TextBlock Grid.Column="3" x:Name="TxtDroU" Text="U: 000.000" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>

                                                    <TextBlock Grid.Column="4" x:Name="TxtDroV" Text="V: 000.000" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>

                                                    <TextBlock Grid.Column="5" x:Name="TxtDroW" Text="W: 000.000" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>

                                                    <TextBlock Grid.Column="6" x:Name="TxtDroH" Text="H: 000" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>

                                                </Grid>

                                            </Border>

                                        </Grid>

                                    </TabItem>



                                    <!-- 其他子頁佔位 -->

                                    <TabItem Header="Point&amp;Path" FontSize="11">

                                        <TextBlock Text="Point&amp;Path calculation &amp; coordinate transformation quick panel." Margin="10" Foreground="#666666"/>

                                    </TabItem>

                                    <TabItem Header="Capture" FontSize="11">

                                        <TextBlock Text="Exposure, Gain, Light Strobe &amp; Trigger Settings." Margin="10" Foreground="#666666"/>

                                    </TabItem>

                                    <TabItem Header="Camera" FontSize="11">

                                        <TextBlock Text="Hardware Camera Attributes &amp; Calibration matrix." Margin="10" Foreground="#666666"/>

                                    </TabItem>

                                </TabControl>

                            </Border>

                        </Grid>

                    </Grid>

                </Grid>

            </TabItem>



            



            <!-- ========================================================= -->

            <!-- ========================================================= -->
            <!-- 4. Modules Info (統一模組中心與兩層式 SubPanel 路由) -->
            <!-- ========================================================= -->
            <TabItem Header="Modules Info">
                <Grid ColumnDefinitions="230,*" Margin="6">
                    <!-- 左側：已載入模組清單 (Loaded Modules List) -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8">
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconGrid}" Fill="#0284C7" Width="13" Height="13" Stretch="Uniform"/>
                                    <TextBlock Text="LOADED MODULES" FontSize="12" FontWeight="Black" Foreground="#0F172A"/>
                                </StackPanel>
                                <TextBlock Text="System@IncludeModule 模組清單" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ListBox x:Name="LstLoadedModules" Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,4">
                                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="{Binding BadgeBackground}" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BadgeText}" FontSize="8.5" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- 右側統一 SubPanel (一級模組面板容器) -->
                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6">
                        <Grid x:Name="ModulesSubPanelHost">
                            <!-- 1. SYSTEM 面板 (RecordS 統一環狀生產記錄與日誌台) -->
                            <Grid x:Name="PnlModuleSystem" RowDefinitions="Auto,*" Margin="6" IsVisible="True">
                                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="SYSTEM MODULE (CORE)" FontWeight="Black" FontSize="14" Foreground="#0F172A"/>
                                                <Border Background="#10B981" CornerRadius="3" Padding="6,1">
                                                    <TextBlock Text="ONLINE / HEALTHY" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="系統執行日誌、Cycle Time、生產週期打卡與健康監控" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,4" Margin="6,0" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="RUN STATE" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TxtSystemRunState" Text="IDLE" FontSize="14" FontWeight="Black" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,4" Margin="6,0" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="CYCLE TIME" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TxtSystemCycleTime" Text="0.00 s" FontSize="14" FontWeight="Black" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="BtnClearSystemLog" Grid.Column="3" Content="🧹 Clear (CLEAR)" Height="28" Padding="10,0" Margin="6,0,0,0" Background="#F1F5F9" Foreground="#475569" FontSize="11" FontWeight="SemiBold" CornerRadius="4"/>
                                    </Grid>
                                </Border>
                                <!-- 2000 槽位 RecordS 核心工作區 (左欄 Channels 清單，右欄 2000 槽位雙欄事件表) -->
                                <Grid Grid.Row="1" ColumnDefinitions="190,*" Margin="0">
                                    <!-- 左欄：[Get RecordS] 按鈐與 Record 通道清單 -->
                                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,6,0">
                                        <Grid RowDefinitions="Auto,*">
                                            <Button x:Name="BtnGetRecords" Grid.Row="0" Content="Get RecordS" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28" FontWeight="Bold" FontSize="11" Background="#E2E8F0" Foreground="#1E293B" CornerRadius="4" Margin="0,0,0,6"/>
                                            <ListBox x:Name="LstRecordChannels" Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4"/>
                                        </Grid>
                                    </Border>
                                    <!-- 右欄：RecordS 儀表 (RecordIndex / Capability) 與 2000 筆事件流水帳 -->
                                    <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8">
                                        <Grid RowDefinitions="Auto,Auto,*">
                                            <!-- 頂部指標列 -->
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="0,0,0,6">
                                                <TextBlock Grid.Column="0" Text="RecordS" FontWeight="Bold" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="RecordIndex" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Border Grid.Column="3" Width="70" Height="24" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Margin="0,0,12,0">
                                                    <TextBlock x:Name="TxtRecordIndex" Text="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0" FontWeight="Bold" FontSize="11" FontFamily="Consolas" Foreground="#0284C7"/>
                                                </Border>
                                                <TextBlock Grid.Column="4" Text="Capability" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Border Grid.Column="5" Width="70" Height="24" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3">
                                                    <TextBlock x:Name="TxtRecordCapability" Text="2000" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0" FontWeight="Bold" FontSize="11" FontFamily="Consolas" Foreground="#475569"/>
                                                </Border>
                                            </Grid>
                                            <!-- 表頭列 -->
                                            <Grid Grid.Row="1" ColumnDefinitions="130,*" Background="#F1F5F9" Margin="0,0,0,4">
                                                <Border Grid.Column="0" Padding="6,4" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0">
                                                    <TextBlock Text="TIMESTAMP" FontWeight="Bold" FontSize="10" Foreground="#475569"/>
                                                </Border>
                                                <Border Grid.Column="1" Padding="8,4">
                                                    <TextBlock Text="MESSAGE / RECORD DATA" FontWeight="Bold" FontSize="10" Foreground="#475569"/>
                                                </Border>
                                            </Grid>
                                            <!-- 2000 槽位虛擬化事件表格 (Sunken Inset 工控立體質感) -->
                                            <ListBox x:Name="LstRecordEntries" Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="2">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="124,*" Margin="0,1">
                                                            <Border Grid.Column="0" Background="#EEF2F6" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding Timestamp}" FontFamily="Consolas" FontSize="11" Foreground="#0284C7" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="8,2">
                                                                <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="11" Foreground="#0F172A" TextWrapping="Wrap"/>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                                <ListBox.Styles>
                                                    <Style Selector="ListBoxItem">
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="MinHeight" Value="24"/>
                                                        <Setter Property="Margin" Value="0,1"/>
                                                    </Style>
                                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="#E0F2FE"/>
                                                    </Style>
                                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                    </Style>
                                                </ListBox.Styles>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- 2. THREAD 面板 (原 Threads Tab 內容) -->
                            <Grid x:Name="PnlModuleThread" ColumnDefinitions="320,*" Margin="6" IsVisible="False">

                    <!-- ===================================================== -->

                    <!-- 左欄：Manager (Thread Main / Thread 0) 永遠常駐檢視 -->

                    <!-- ===================================================== -->

                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0">

                        <Grid RowDefinitions="Auto,*">

                            <!-- 頂部標題列 (深藍管理器 Header) -->

                            <Border Grid.Row="0" Background="#0055AA" CornerRadius="5,5,0,0" Padding="8,5">

                                <Grid ColumnDefinitions="*,Auto">

                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                        <TextBlock Text="Thread Main (0)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>

                                        <Border Background="#0284C7" CornerRadius="3" Padding="4,1">

                                            <TextBlock Text="MANAGER" FontWeight="Black" FontSize="9" Foreground="#FFFFFF"/>

                                        </Border>

                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="Master Controller" FontSize="10" Foreground="#BAE6FD" VerticalAlignment="Center"/>

                                </Grid>

                            </Border>



                            <!-- 監控控制項 (IsFullView="True") -->

                            <controls:ThreadMonitorControl x:Name="MonitorThreadMain" Grid.Row="1" IsFullView="True"/>

                        </Grid>

                    </Border>



                    <!-- ===================================================== -->

                    <!-- 右欄：Worker (1~6, 7~12) 與 SubThread 分頁切換 -->

                    <!-- ===================================================== -->

                    <TabControl x:Name="TabThreadsRight" Grid.Column="1" Margin="0">

                        <!-- 頁籤 1: Thread 1~6 -->

                        <TabItem Header="Thread 1~6">

                            <Grid ColumnDefinitions="*,*" Margin="4">

                                <!-- 左半部：Thread 1 / 3 / 5 -->

                                <Grid Grid.Column="0" RowDefinitions="*,*,*" Margin="0,0,4,0">

                                    <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">

                                        <controls:ThreadMonitorControl x:Name="MonitorThread1"/>

                                    </Border>

                                    <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">

                                        <controls:ThreadMonitorControl x:Name="MonitorThread3"/>

                                    </Border>

                                    <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">

                                        <controls:ThreadMonitorControl x:Name="MonitorThread5"/>

                                    </Border>

                                </Grid>



                                <!-- 右半部：Thread 2 / 4 / 6 -->

                                <Grid Grid.Column="1" RowDefinitions="*,*,*" Margin="4,0,0,0">

                                    <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">

                                        <controls:ThreadMonitorControl x:Name="MonitorThread2"/>

                                    </Border>

                                    <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">

                                        <controls:ThreadMonitorControl x:Name="MonitorThread4"/>

                                    </Border>

                                    <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">

                                        <controls:ThreadMonitorControl x:Name="MonitorThread6"/>

                                    </Border>

                                </Grid>

                            </Grid>

                        </TabItem>



                        <!-- 頁籤 2: Thread 7~12 -->

                        <TabItem Header="Thread 7~12">

                            <Grid ColumnDefinitions="*,*" Margin="4">

                                <!-- 左半部：Thread 7 / 9 / 11 -->

                                <Grid Grid.Column="0" RowDefinitions="*,*,*" Margin="0,0,4,0">

                                    <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">

                                        <controls:ThreadMonitorControl x:Name="MonitorThread7"/>

                                    </Border>

                                    <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">

                                        <controls:ThreadMonitorControl x:Name="MonitorThread9"/>

                                    </Border>

                                    <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">

                                        <controls:ThreadMonitorControl x:Name="MonitorThread11"/>

                                    </Border>

                                </Grid>



                                <!-- 右半部：Thread 8 / 10 / 12 -->

                                <Grid Grid.Column="1" RowDefinitions="*,*,*" Margin="4,0,0,0">

                                    <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">

                                        <controls:ThreadMonitorControl x:Name="MonitorThread8"/>

                                    </Border>

                                    <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">

                                        <controls:ThreadMonitorControl x:Name="MonitorThread10"/>

                                    </Border>

                                    <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">

                                        <controls:ThreadMonitorControl x:Name="MonitorThread12"/>

                                    </Border>

                                </Grid>

                            </Grid>

                        </TabItem>



                        <!-- 頁籤 3: SubThread (動態子執行緒池 - 支援 List 與 SubPanel) -->

                        <TabItem Header="SubThread">

                            <Grid RowDefinitions="Auto,*" Margin="4">

                                <!-- 頂部工具列 -->

                                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">

                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">

                                        <Button x:Name="BtnGetSubThreadList" Grid.Column="0" Height="26" Padding="10,0" 

                                                Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="4"

                                                ToolTip.Tip="重新整理並讀取當前虛擬機註冊的所有 SubThreads">

                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                                <Path Data="{StaticResource IconRefresh}" Fill="White" Width="11" Height="11" Stretch="Uniform"/>

                                                <TextBlock Text="GetSubThreadList" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>

                                            </StackPanel>

                                        </Button>



                                        <TextBlock x:Name="TxtSubThreadCount" Grid.Column="1" Text="SubThreads: 0 Active" 

                                                   VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="12,0"/>



                                        <Button x:Name="BtnDemoSubThread" Grid.Column="3" Height="25" Padding="8,0" 

                                                Background="#059669" Foreground="White" FontSize="10.5" CornerRadius="3"

                                                ToolTip.Tip="啟動示範背景子執行緒 (Demo Task &amp; System Hook)">

                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                                                <Path Data="{StaticResource IconPlay}" Fill="White" Width="9" Height="9" Stretch="Uniform"/>

                                                <TextBlock Text="+ Demo SubThread" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>

                                            </StackPanel>

                                        </Button>

                                    </Grid>

                                </Border>



                                <!-- 下半部：左側 SubThread 清單，右側 SubPanel 畫面 -->

                                <Grid Grid.Row="1" ColumnDefinitions="260,*">

                                    <!-- 左欄：SubThread 清單 -->

                                    <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">

                                        <ListBox x:Name="LstSubThreads" Background="White" BorderThickness="0">

                                            <ListBox.ItemTemplate>

                                                <DataTemplate>

                                                    <Border Padding="6,4" BorderThickness="0,0,0,1" BorderBrush="#F1F5F9">

                                                        <Grid ColumnDefinitions="*,Auto">

                                                            <StackPanel Grid.Column="0" Spacing="2">

                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#0F172A"/>

                                                                <TextBlock Text="{Binding ProgSummary}" FontSize="9.5" Foreground="#64748B"/>

                                                            </StackPanel>

                                                            <Border Grid.Column="1" Background="{Binding BadgeBackground}" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">

                                                                <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>

                                                            </Border>

                                                        </Grid>

                                                    </Border>

                                                </DataTemplate>

                                            </ListBox.ItemTemplate>

                                        </ListBox>

                                    </Border>



                                    <!-- 右欄：SubPanel 監控容器 -->

                                    <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">

                                        <Panel>

                                            <controls:ThreadMonitorControl x:Name="MonitorSubThreadDetail" IsFullView="True"/>

                                            <!-- 未選取時引導提示畫面 -->

                                            <Border x:Name="PnlSubThreadEmptyNotice" Background="White" IsVisible="True">

                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">

                                                    <TextBlock Text="尚未選取 SubThread" FontWeight="Bold" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"/>

                                                    <TextBlock Text="請點選左側清單中的子執行緒，或點擊 GetSubThreadList / + Demo SubThread" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>

                                                </StackPanel>

                                            </Border>

                                        </Panel>

                                    </Border>

                                </Grid>

                            </Grid>

                        </TabItem>

                    </TabControl>

                            </Grid>

                            <!-- 3. VARIABLE 面板 (原 Parameter&Variable Tab 內容) -->
                            <Grid x:Name="PnlModuleVariable" Margin="6" RowDefinitions="Auto,*" IsVisible="False">

                    <!-- 頂部工具列 -->

                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">

                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                                <Button x:Name="BtnRefreshVariables" Height="28" Padding="10,0" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="4">



                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">



                                        <Path Data="{StaticResource IconRefresh}" Fill="White" Width="12" Height="12" Stretch="Uniform"/>



                                        <TextBlock Text="Refresh Variables" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>



                                    </StackPanel>



                                </Button>

                                <TextBlock x:Name="TxtVariableSummary" Text="Total Variables: 0" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="8,0"/>

                            </StackPanel>



                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">

                                <TextBlock Text="Section:" VerticalAlignment="Center" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>

                                <ComboBox x:Name="CmbVariableSection" Width="130" Height="28" FontSize="11">

                                    <ComboBoxItem Content="Global" IsSelected="True"/>

                                </ComboBox>

                            </StackPanel>



                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">

                                <Button x:Name="BtnSaveVariables" Height="28" Padding="10,0" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="4">



                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">



                                        <Path Data="{StaticResource IconFloppySave}" Fill="White" Width="12" Height="12" Stretch="Uniform"/>



                                        <TextBlock Text="Save Variables" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>



                                    </StackPanel>



                                </Button>

                                <Button x:Name="BtnLoadVariables" Height="28" Padding="10,0" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="4">



                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">



                                        <Path Data="{StaticResource IconFolderOpen}" Fill="White" Width="12" Height="12" Stretch="Uniform"/>



                                        <TextBlock Text="Load Variables" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>



                                    </StackPanel>



                                </Button>

                            </StackPanel>

                        </Grid>

                    </Border>



                    <Grid Grid.Row="1" ColumnDefinitions="260,*,320">

                        <!-- 第 1 欄：變數清單 -->

                        <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,8,0">

                            <Grid RowDefinitions="Auto,*">

                                <TextBlock Grid.Row="0" Text="Variables (VariableEngine):" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>

                                <ListBox x:Name="LstVariables" Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4"/>

                            </Grid>

                        </Border>



                        <!-- 第 2 欄：變數總覽 DataGrid -->

                        <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,8,0">

                            <Grid RowDefinitions="Auto,*">

                                <TextBlock Grid.Row="0" Text="Variable Table (Section: All/Global):" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>

                                <DataGrid x:Name="GridVariables" Grid.Row="1" Background="White" AutoGenerateColumns="False"

                                          CanUserResizeColumns="True" HeadersVisibility="Column" GridLinesVisibility="All"

                                          HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0" RowHeight="24">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="110"/>

                                        <DataGridTextColumn Header="Variable Key" Binding="{Binding Key}" Width="150"/>

                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </Grid>

                        </Border>



                        <!-- 第 3 欄：所選變數詳情與修改編輯器 -->

                        <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12">

                            <StackPanel Spacing="10">

                                <TextBlock Text="Variable Inspector &amp; Set" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>



                                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,6">

                                    <StackPanel Spacing="4">

                                        <TextBlock Text="KEY NAME:" FontSize="9.5" Foreground="#64748B" FontWeight="SemiBold"/>

                                        <TextBox x:Name="TxtVarEditKey" Height="26" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>

                                        <TextBlock Text="SECTION:" FontSize="9.5" Foreground="#64748B" FontWeight="SemiBold" Margin="0,4,0,0"/>

                                        <TextBox x:Name="TxtVarEditSection" Text="Global" Height="26" FontSize="11"/>

                                    </StackPanel>

                                </Border>



                                <TextBlock Text="RAW VALUE:" FontSize="9.5" Foreground="#64748B" FontWeight="SemiBold"/>

                                <TextBox x:Name="TxtVarEditValue" Height="100" AcceptsReturn="True" TextWrapping="Wrap" FontSize="11" Background="#F8FAFC" BorderBrush="#CBD5E1"/>



                                <Button x:Name="BtnApplyVarEdit" Height="30" Background="#0284C7" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="4">



                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">



                                        <Path Data="{StaticResource IconCheck}" Fill="White" Width="12" Height="12" Stretch="Uniform"/>



                                        <TextBlock Text="Set / Update Variable" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>



                                    </StackPanel>



                                </Button>



                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,0">

                                    <StackPanel Spacing="4">

                                        <TextBlock Text="Array/List Elements:" FontSize="10" FontWeight="Bold" Foreground="#334155"/>

                                        <ListBox x:Name="LstVarElements" Height="120" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="10"/>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </Border>

                    </Grid>

                            </Grid>

                            <!-- 4. POINT&PATH 面板 (原 Point&Path Tab 內容) -->
                            <Grid x:Name="PnlModulePointPath" Margin="6" RowDefinitions="Auto,*" IsVisible="False">

                    <!-- 頂部工具列 -->

                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">

                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                                <Button x:Name="BtnRefreshPoints" Height="28" Padding="10,0" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="4">



                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">



                                        <Path Data="{StaticResource IconRefresh}" Fill="White" Width="12" Height="12" Stretch="Uniform"/>



                                        <TextBlock Text="Refresh Points" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>



                                    </StackPanel>



                                </Button>

                                <TextBlock x:Name="TxtPointSummary" Text="Total Points: 0" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="8,0"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">

                                <Button x:Name="BtnSavePoints" Height="28" Padding="10,0" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="4" ToolTip.Tip="儲存點位至 POINT&amp;PATH/Points.ini">



                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">



                                        <Path Data="{StaticResource IconFloppySave}" Fill="White" Width="12" Height="12" Stretch="Uniform"/>



                                        <TextBlock Text="Save (POINT&amp;PATH)" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>



                                    </StackPanel>



                                </Button>

                                <Button x:Name="BtnLoadPoints" Height="28" Padding="10,0" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="4" ToolTip.Tip="從 POINT&amp;PATH/ 載入點位">



                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">



                                        <Path Data="{StaticResource IconFolderOpen}" Fill="White" Width="12" Height="12" Stretch="Uniform"/>



                                        <TextBlock Text="Load (POINT&amp;PATH)" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>



                                    </StackPanel>



                                </Button>

                            </StackPanel>

                        </Grid>

                    </Border>



                    <Grid Grid.Row="1" ColumnDefinitions="260,*,320">

                        <!-- 第 1 欄：點位清單 -->

                        <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,8,0">

                            <Grid RowDefinitions="Auto,*">

                                <TextBlock Grid.Row="0" Text="Point Keys (PointEngine):" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>

                                <ListBox x:Name="LstPoints" Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4"/>

                            </Grid>

                        </Border>



                        <!-- 第 2 欄：所有點位 DataGrid 表格總覽 -->

                        <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,8,0">

                            <Grid RowDefinitions="Auto,*">

                                <TextBlock Grid.Row="0" Text="Points Table (Overview):" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>

                                <DataGrid x:Name="GridPoints" Grid.Row="1" Background="White" AutoGenerateColumns="False" 

                                          CanUserResizeColumns="True" HeadersVisibility="Column" GridLinesVisibility="All"

                                          HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0" RowHeight="24">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Point Name" Binding="{Binding Name}" Width="120"/>

                                        <DataGridTextColumn Header="X (mm)" Binding="{Binding X}" Width="75"/>

                                        <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y}" Width="75"/>

                                        <DataGridTextColumn Header="Z (mm)" Binding="{Binding Z}" Width="75"/>

                                        <DataGridTextColumn Header="U (deg)" Binding="{Binding U}" Width="75"/>

                                        <DataGridTextColumn Header="V (deg)" Binding="{Binding V}" Width="75"/>

                                        <DataGridTextColumn Header="W (deg)" Binding="{Binding W}" Width="75"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </Grid>

                        </Border>



                        <!-- 第 3 欄：所選點位 6 軸 DRO 座標卡片與微調 -->

                        <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12">

                            <StackPanel Spacing="10">

                                <TextBlock Text="Selected Point DRO &amp; Editor" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>

                                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4">

                                    <StackPanel Orientation="Horizontal" Spacing="6">

                                        <TextBlock Text="Target Key:" FontWeight="SemiBold" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>

                                        <TextBox x:Name="TxtPointEditKey" Width="180" Height="26" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>

                                    </StackPanel>

                                </Border>



                                <!-- 6 軸座標輸入/顯示盒 -->

                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4">

                                    <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Margin="2" Padding="6,4" CornerRadius="4">

                                        <StackPanel>

                                            <TextBlock Text="X AXIS" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7"/>

                                            <TextBox x:Name="TxtPointX" Text="0.000" FontSize="13" FontWeight="Black" Height="26" Padding="2,0"/>

                                        </StackPanel>

                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Margin="2" Padding="6,4" CornerRadius="4">

                                        <StackPanel>

                                            <TextBlock Text="Y AXIS" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7"/>

                                            <TextBox x:Name="TxtPointY" Text="0.000" FontSize="13" FontWeight="Black" Height="26" Padding="2,0"/>

                                        </StackPanel>

                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Margin="2" Padding="6,4" CornerRadius="4">

                                        <StackPanel>

                                            <TextBlock Text="Z AXIS" FontSize="9.5" FontWeight="Bold" Foreground="#10B981"/>

                                            <TextBox x:Name="TxtPointZ" Text="0.000" FontSize="13" FontWeight="Black" Height="26" Padding="2,0"/>

                                        </StackPanel>

                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Margin="2" Padding="6,4" CornerRadius="4">

                                        <StackPanel>

                                            <TextBlock Text="U (Rz)" FontSize="9.5" FontWeight="Bold" Foreground="#7C3AED"/>

                                            <TextBox x:Name="TxtPointU" Text="0.000" FontSize="13" FontWeight="Black" Height="26" Padding="2,0"/>

                                        </StackPanel>

                                    </Border>

                                    <Border Grid.Row="2" Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Margin="2" Padding="6,4" CornerRadius="4">

                                        <StackPanel>

                                            <TextBlock Text="V (Ry)" FontSize="9.5" FontWeight="Bold" Foreground="#D97706"/>

                                            <TextBox x:Name="TxtPointV" Text="0.000" FontSize="13" FontWeight="Black" Height="26" Padding="2,0"/>

                                        </StackPanel>

                                    </Border>

                                    <Border Grid.Row="2" Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Margin="2" Padding="6,4" CornerRadius="4">

                                        <StackPanel>

                                            <TextBlock Text="W (Rx)" FontSize="9.5" FontWeight="Bold" Foreground="#D97706"/>

                                            <TextBox x:Name="TxtPointW" Text="0.000" FontSize="13" FontWeight="Black" Height="26" Padding="2,0"/>

                                        </StackPanel>

                                    </Border>

                                </Grid>



                                <Button x:Name="BtnApplyPointEdit" Content="Apply / Set Point" Height="30" Background="#0284C7" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="4"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                            </Grid>

                            <!-- 5. CALL 面板 (外部單檔 CSVI 管理與 CsviStudio 整合) -->
                            <Grid x:Name="PnlModuleCall" ColumnDefinitions="260,*" Margin="6" IsVisible="False">
                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="10">
                                    <Grid RowDefinitions="Auto,*,Auto">
                                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock Text="STANDALONE CSVI" FontSize="12" FontWeight="Black" Foreground="#0F172A"/>
                                            <TextBlock Text="ExternalModules/*.csvi (Call@)" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ListBox x:Name="LstCallFiles" Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4"/>
                                        <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                                            <Button x:Name="BtnRefreshCallFiles" Content="Refresh CSVI List" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="4"/>
                                            <Button x:Name="BtnOpenCsviStudio" Content="🛠 Open CsviStudio" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="30" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="11.5" CornerRadius="4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="0">
                                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,*,*">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="SELECTED CALL CSVI" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock x:Name="TxtCallSelectedFile" Text="None" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="LAST EXEC DURATION" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock x:Name="TxtCallDuration" Text="-- ms" FontSize="13" FontWeight="Bold" Foreground="#10B981" FontFamily="Consolas"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="STATUS / RETURN" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock x:Name="TxtCallStatus" Text="IDLE" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" FontFamily="Consolas"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <Grid RowDefinitions="Auto,Auto,*,Auto,140">
                                            <TextBlock Grid.Row="0" Text="INTERACTIVE TEST HARNESS (互動式單元測試)" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,8"/>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,110,Auto,Auto" Margin="0,0,0,8">
                                                <TextBox x:Name="TxtCallTestArgs" Watermark="輸入測試參數 (如: 10,20)" Height="28" FontSize="11" Margin="0,0,6,0"/>
                                                <ComboBox x:Name="CmbCallTestMode" Grid.Column="1" Height="28" FontSize="11" Margin="0,0,6,0">
                                                    <ComboBoxItem Content="Debug" IsSelected="True"/>
                                                    <ComboBoxItem Content="Runtime &amp;"/>
                                                    <ComboBoxItem Content="Reentrant &amp;&amp;"/>
                                                </ComboBox>
                                                <Button x:Name="BtnCallApplyFromWizard" Grid.Column="2" Content="📋 帶入導引參數" Height="28" Padding="10,0" Background="#475569" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="4" Margin="0,0,6,0"/>
                                                <Button x:Name="BtnCallRunTest" Grid.Column="3" Content="▶ Run Test" Height="28" Padding="12,0" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="4"/>
                                            </Grid>

                                            <!-- CSVI 雙視圖容器 (先 Wizard 參數導引，後 FrontPanel 執行結果) -->
                                            <TabControl x:Name="TabCallViews" Grid.Row="2" Margin="0,0,0,8">
                                                <TabItem x:Name="TabCallWizard" Header="⚙️ 參數導引精靈 (Wizard)">
                                                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12" MinHeight="180">
                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                            <Border x:Name="PnlCallWizardHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                                <TextBlock Text="請選取左側 CSVI 檔案以載入 Parameter Guidance 導引視圖" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
                                                            </Border>
                                                        </ScrollViewer>
                                                    </Border>
                                                </TabItem>
                                                <TabItem x:Name="TabCallFrontPanel" Header="🖥️ 執行時前面板 (FrontPanel)">
                                                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12" MinHeight="180">
                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                            <Border x:Name="PnlCallFrontPanelHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                                <TextBlock Text="請選取左側 CSVI 檔案以載入 FrontPanel 前面板" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
                                                            </Border>
                                                        </ScrollViewer>
                                                    </Border>
                                                </TabItem>
                                            </TabControl>

                                            <TextBlock Grid.Row="3" Text="EXECUTION LOG / OUTPUT:" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                            <Border Grid.Row="4" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6">
                                                <TextBox x:Name="TxtCallTestOutput" AcceptsReturn="True" IsReadOnly="True" Background="Transparent" Foreground="#38BDF8" FontFamily="Consolas" FontSize="11" BorderThickness="0"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- 6. IO 子面板 (兩層 SubPanel: 左側 Devices 清單，右側次級 Driver SubPanel) -->
                            <Grid x:Name="PnlModuleIo" ColumnDefinitions="240,*" Margin="6" IsVisible="False">
                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8">
                                    <Grid RowDefinitions="Auto,*,Auto">
                                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock Text="IO DEVICES &amp; DRIVERS" FontWeight="Black" FontSize="12" Foreground="#0F172A"/>
                                            <TextBlock Text="Hardware IO Devices" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ListBox x:Name="LstIoDrivers" Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4"/>
                                        <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,8,0,0">
                                            <TextBlock Text="💡 提示：點擊列表裝置可於右側載入該 Driver 之即時控制面板 (SubPanel)" FontSize="9.5" Foreground="#1E40AF" TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0">
                                    <ContentControl x:Name="DriverViewContainer" Background="White"/>
                                </Border>
                            </Grid>

                            <!-- 7. CAPTURE / IMAQ 子面板 (兩層 SubPanel: 設備清單 + 驅動/影像視圖) -->
                            <Grid x:Name="PnlModuleCapture" ColumnDefinitions="240,*" Margin="6" IsVisible="False">
                                <!-- 左側：相機硬體清單與 IMAQ 影像緩衝區 -->
                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8">
                                    <Grid RowDefinitions="Auto,*,Auto,*,Auto">
                                        <StackPanel Grid.Row="0" Margin="0,0,0,4">
                                            <TextBlock Text="CAMERAS &amp; DRIVERS" FontWeight="Black" FontSize="11.5" Foreground="#0F172A"/>
                                            <TextBlock Text="Hardware Capture Devices" FontSize="9.5" Foreground="#64748B"/>
                                        </StackPanel>
                                        <ListBox x:Name="LstCaptureDrivers" Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8"/>
                                        
                                        <StackPanel Grid.Row="2" Margin="0,0,0,4">
                                            <TextBlock Text="IMAQ IMAGE BUFFERS" FontWeight="Black" FontSize="11.5" Foreground="#0F172A"/>
                                            <TextBlock Text="In-Memory Image Frames" FontSize="9.5" Foreground="#64748B"/>
                                        </StackPanel>
                                        <ListBox x:Name="LstImaqImages" Grid.Row="3" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4"/>
                                        
                                        <StackPanel Grid.Row="4" Spacing="4" Margin="0,8,0,0">
                                            <Button x:Name="BtnRefreshImaq" Content="Refresh Devices &amp; IMAQ" Height="26" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="10.5" CornerRadius="4"/>
                                            <Button x:Name="BtnSaveImaq" Content="Save Selected Image" Height="26" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="10.5" CornerRadius="4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 右側：二級 SubPanel 容器 (動態掛載相機驅動視圖 MockCameraView 或 IMAQ 預覽視圖) -->
                                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6">
                                    <Grid RowDefinitions="Auto,*">
                                        <!-- 頂部資訊與切換工具列 -->
                                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="VIEW:" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    <RadioButton x:Name="RbCaptureDriverView" Content="Camera Driver SubPanel" IsChecked="True" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <RadioButton x:Name="RbCaptureImaqView" Content="IMAQ Frame Inspector" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtImaqSummary" Grid.Column="1" Text="Total Images: 0" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="Frame:" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                                    <ComboBox x:Name="CmbImaqFrameIndex" Width="55" Height="24" FontSize="11">
                                                        <ComboBoxItem Content="0" IsSelected="True"/>
                                                        <ComboBoxItem Content="1"/>
                                                        <ComboBoxItem Content="2"/>
                                                        <ComboBoxItem Content="3"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Ellipse x:Name="LedImaqOk" Width="10" Height="10" Fill="#10B981"/>
                                                    <TextBlock x:Name="TxtImaqStatus" Text="READY" FontSize="10" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 內容區：依切換顯示 Driver 視圖或 IMAQ 預覽視圖 -->
                                        <Grid Grid.Row="1">
                                            <!-- 1. Driver View Host -->
                                            <ContentControl x:Name="PnlCaptureDriverSubPanelHost"/>
                                            
                                            <!-- 2. IMAQ Image Inspector Host -->
                                            <Grid x:Name="PnlCaptureImaqInspector" RowDefinitions="Auto,*" IsVisible="False">
                                                <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="*,*,*,*">
                                                        <TextBlock x:Name="TxtImaqSelectedKey" Grid.Column="0" Text="Key: None" FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>
                                                        <TextBlock x:Name="TxtImaqResolution" Grid.Column="1" Text="Res: --" FontSize="11" Foreground="#475569"/>
                                                        <TextBlock x:Name="TxtImaqFramesOverlays" Grid.Column="2" Text="Frames: 0" FontSize="11" Foreground="#475569"/>
                                                        <TextBlock x:Name="TxtImaqTimestamp" Grid.Column="3" Text="Time: --" FontSize="11" Foreground="#475569"/>
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4">
                                                    <Grid>
                                                        <Image x:Name="ImgImaqPreview" Stretch="Uniform" Margin="8"/>
                                                        <TextBlock x:Name="TxtImaqPlaceholder" Text="No Image Selected or Buffer Empty" Foreground="#64748B" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 8. MOTION 子面板 (兩層 SubPanel: 運動控制器清單 + 驅動視圖) -->
                            <Grid x:Name="PnlModuleMotion" ColumnDefinitions="240,*" Margin="6" IsVisible="False">
                                <!-- 左側：運動控制器與軸群清單 -->
                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8">
                                    <Grid RowDefinitions="Auto,*,Auto">
                                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock Text="MOTION CONTROLLERS" FontWeight="Black" FontSize="12" Foreground="#0F172A"/>
                                            <TextBlock Text="Discovered Motion Hardware" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ListBox x:Name="LstMotionDrivers" Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4"/>
                                        <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                                            <Button x:Name="BtnRefreshMotionDrivers" Content="Refresh Motion Devices" Height="28" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="4"/>
                                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6">
                                                <TextBlock Text="💡 提示：點擊控制器可於右側載入對應 Driver 之手動寸動 (Jog) 與伺服控制 SubPanel" FontSize="9.5" Foreground="#1E40AF" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 右側：二級 SubPanel 容器 (動態掛載 MockMotionView) -->
                                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="4">
                                    <ContentControl x:Name="PnlMotionDriverSubPanelHost"/>
                                </Border>
                            </Grid>

                            <!-- 9. DAQ 子面板 (兩層 SubPanel: 採集裝置清單 + 驅動/波形視圖) -->
                            <Grid x:Name="PnlModuleDaq" ColumnDefinitions="240,*" Margin="6" IsVisible="False">
                                <!-- 左側：採集硬體清單與波形記錄 -->
                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8">
                                    <Grid RowDefinitions="Auto,*,Auto,*,Auto">
                                        <StackPanel Grid.Row="0" Margin="0,0,0,4">
                                            <TextBlock Text="DAQ DEVICES &amp; DRIVERS" FontWeight="Black" FontSize="11.5" Foreground="#0F172A"/>
                                            <TextBlock Text="Hardware Acquisition Devices" FontSize="9.5" Foreground="#64748B"/>
                                        </StackPanel>
                                        <ListBox x:Name="LstDaqDrivers" Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8"/>
                                        
                                        <StackPanel Grid.Row="2" Margin="0,0,0,4">
                                            <TextBlock Text="WAVEFORM BUFFERS" FontWeight="Black" FontSize="11.5" Foreground="#0F172A"/>
                                            <TextBlock Text="Logged Analog Waves" FontSize="9.5" Foreground="#64748B"/>
                                        </StackPanel>
                                        <ListBox x:Name="LstWaveforms" Grid.Row="3" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4"/>
                                        
                                        <StackPanel Grid.Row="4" Spacing="4" Margin="0,8,0,0">
                                            <Button x:Name="BtnRefreshWaveforms" Content="Refresh Devices &amp; Waves" Height="26" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="10.5" CornerRadius="4"/>
                                            <Button x:Name="BtnSaveWaveform" Content="Save Waveform (.csv)" Height="26" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="10.5" CornerRadius="4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 右側：二級 SubPanel 容器 (動態掛載 DAQ 驅動視圖 MockDaqView 或 ScottPlot AvaPlot 波形分析) -->
                                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6">
                                    <Grid RowDefinitions="Auto,*">
                                        <!-- 頂部資訊與切換工具列 -->
                                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="VIEW:" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    <RadioButton x:Name="RbDaqDriverView" Content="DAQ Driver SubPanel" IsChecked="True" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <RadioButton x:Name="RbDaqWaveformView" Content="Oscilloscope Waveform Plot" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtWaveformSummary" Grid.Column="1" Text="Total Waveforms: 0" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="Channel:" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                                    <ComboBox x:Name="CmbWaveformChannel" Width="70" Height="24" FontSize="11">
                                                        <ComboBoxItem Content="Ch 0" IsSelected="True"/>
                                                        <ComboBoxItem Content="Ch 1"/>
                                                        <ComboBoxItem Content="Ch 2"/>
                                                        <ComboBoxItem Content="Ch 3"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 內容區：依切換顯示 Driver 視圖或 ScottPlot AvaPlot -->
                                        <Grid Grid.Row="1">
                                            <!-- 1. Driver View Host -->
                                            <ContentControl x:Name="PnlDaqDriverSubPanelHost"/>
                                            
                                            <!-- 2. ScottPlot AvaPlot Waveform Host -->
                                            <Border x:Name="PnlDaqWaveformHost" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="4" IsVisible="False">
                                                <ScottPlot:AvaPlot x:Name="DaqPlot"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            



            <!-- ========================================================= -->

            <!-- 9. Panel CMD -->

            <!-- ========================================================= -->

            <TabItem Header="Panel CMD">

                <Grid Margin="20" RowDefinitions="Auto,*">

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">

                        <TextBlock Text="Manual CMD:" VerticalAlignment="Center" FontWeight="Bold"/>

                        <TextBox Width="400" Height="28" Text="IO@SetPort::P0.0;"/>

                        <Button Content="Execute" Width="90" Height="28" Background="#007ACC" Foreground="White"/>

                    </StackPanel>

                    <TextBox Grid.Row="1" Background="White" FontFamily="Consolas" IsReadOnly="True"/>

                </Grid>

            </TabItem>



            <!-- ========================================================= -->

            <!-- 10. Remote (Telnet 2800~2812) -->

            <!-- ========================================================= -->

            <TabItem Header="Remote">

                <Grid Margin="15" ColumnDefinitions="220,*,260">

                    <ListBox Grid.Column="0" Background="White" Margin="0,0,10,0"/>

                    <DataGrid Grid.Column="1" Background="White" Margin="0,0,10,0"/>

                    <StackPanel Grid.Column="2" Spacing="6">

                        <Button Content="$SetIO,P0.0=1" Height="26" Background="#E0E0E0"/>

                        <Button Content="$GetIO,P0.0" Height="26" Background="#E0E0E0"/>

                        <Button Content="$Execute (Run Script)" Height="26" Background="#E0E0E0"/>

                        <TextBox Height="200" Background="White" FontFamily="Consolas" IsReadOnly="True" Margin="0,10,0,0"/>

                    </StackPanel>

                </Grid>

            </TabItem>

            <!-- ========================================================= -->
            <!-- 6. CSVI STUDIO (內嵌式 IDE 與動態 MCP Server) -->
            <!-- ========================================================= -->
            <TabItem x:Name="TabStudio" Header="CSVI STUDIO: MCP 48800">
                <studio:CsviStudioControl x:Name="StudioControl"/>
            </TabItem>

        </TabControl>

    </Grid>

</Window>

