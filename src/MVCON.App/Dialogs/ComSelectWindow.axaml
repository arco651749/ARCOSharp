<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MVCON.App.Dialogs.ComSelectWindow"
        Title="ARCOS Command Selector"
        Width="700" Height="440"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        RequestedThemeVariant="Light"
        Background="#F8FAFC">

    <Grid RowDefinitions="Auto,*,Auto" Margin="14">
        <!-- 頂部說明條 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" 
                Padding="12,8" Margin="0,0,0,10" CornerRadius="6" BoxShadow="0 1 2 0 #08000000">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="🏷️ COM SELECT" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>
                    </Border>
                    <TextBlock Text="選擇模組分類與指令動作" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TxtSelectedCategory" Text="目前分類: [ System > ]" FontWeight="Bold" FontSize="11" Foreground="#0284C7" 
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- 中央主次雙層選擇區域 -->
        <Grid Grid.Row="1" ColumnDefinitions="240,*" Margin="0,0,0,10">
            <!-- 左側：第一層主分類 Com Select.vi (System >, Thread >, IO >, Motion > ...) -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" 
                    Padding="6" Margin="0,0,8,0" CornerRadius="6" BoxShadow="0 1 2 0 #08000000">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="1. 模組分類 (Modules)" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="6,4,6,6"/>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl x:Name="ItemsCategories">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DisplayName}" Tag="{Binding ModuleKey}"
                                            Height="30" HorizontalAlignment="Stretch" Margin="2,2"
                                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                            Foreground="#0F172A" FontWeight="SemiBold" FontSize="11"
                                            CornerRadius="4" Cursor="Hand"
                                            HorizontalContentAlignment="Left" Padding="10,0"
                                            Click="OnCategoryClick"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右側：第二層具體動作 Com Select2.vi (Log Message, Delay, GoPoint, Snap ...) -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" 
                    Padding="8" CornerRadius="6" BoxShadow="0 1 2 0 #08000000">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock x:Name="TxtSubCategoryHeader" Grid.Row="0" Text="2. 具體指令 (Com Select2.vi)" 
                               FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="4,4,4,8"/>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl x:Name="ItemsActions">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" 
                                            Width="195" Height="32" Margin="3"
                                            Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                                            Foreground="#0F172A" FontWeight="SemiBold" FontSize="11"
                                            CornerRadius="4" Cursor="Hand"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Click="OnActionClick"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部取消按鈕 -->
        <Border Grid.Row="2" Background="Transparent" Padding="0,2,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="BtnCancel" Content="✖ 取消 (Cancel)" Width="110" Height="30" 
                        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569" 
                        FontWeight="SemiBold" FontSize="11" CornerRadius="4" Cursor="Hand" Click="OnCancelClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
