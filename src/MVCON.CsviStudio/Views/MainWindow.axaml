<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MVCON.CsviStudio.Views.MainWindow"
        Title="🛠️ CSVI Studio 3.0 - Grand Unified Instrument IDE"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, Auto, *, 120">
        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#1E1E24" Padding="10,8" BorderBrush="#333" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="OpenBtn" Content="📂 Open .csvi" Click="OnOpenClick" Background="#2D2D30"/>
                <Button Name="NewBtn" Content="✨ New CSVI" Click="OnNewClick" Background="#2D2D30"/>
                <Button Name="BuildBtn" Content="⚡ Build &amp; Save (Ctrl+S)" Click="OnBuildClick" Background="#0E639C" Foreground="White" FontWeight="Bold"/>
                
                <Separator Width="1" Margin="4,0" Background="#444"/>
                
                <TextBlock Text="Packaging Mode:" VerticalAlignment="Center" Foreground="#AAA"/>
                <ComboBox Name="ModeCombo" SelectedIndex="0" Width="170">
                    <ComboBoxItem Content="🟢 PortableOpen"/>
                    <ComboBoxItem Content="🟡 PasswordLocked"/>
                    <ComboBoxItem Content="🔴 StrippedRelease"/>
                </ComboBox>

                <Button Name="SetPasswordBtn" Content="🔑 Password..." Click="OnSetPasswordClick" Background="#2D2D30"/>
                <Button Name="ExportSourceBtn" Content="📤 Export Source" Click="OnExportSourceClick" Background="#2D2D30"/>

                <TextBlock Name="SdkStatusBlock" Text="SDK: MVCON-SDK-8.0.1 [✔ ALIGNED]" 
                           VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#4EC9B0" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Status / Header Bar -->
        <Border Grid.Row="1" Background="#252526" Padding="12,6" BorderBrush="#333" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Name="CurrentFileBlock" Text="No file opened" Foreground="#CCC" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Name="ModeStatusBlock" Text="Mode: PortableOpen" Foreground="#888" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Workspace: Split Left (Source Tabs) & Right (Live Preview / Sandbox) -->
        <Grid Grid.Row="2" ColumnDefinitions="*, 480">
            <!-- Left: Source Code Tabs -->
            <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,0,1,0">
                <TabControl Name="SourceTabs">
                    <TabItem Header="📄 Logic.cs">
                        <TextBox Name="LogicEditor" AcceptsReturn="True" AcceptsTab="True" 
                                 FontFamily="Cascadia Code, Consolas, Courier New" FontSize="13"
                                 Background="#1E1E1E" Foreground="#D4D4D4" BorderThickness="0"/>
                    </TabItem>
                    <TabItem Header="🎨 Wizard.axaml">
                        <TextBox Name="WizardEditor" AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="Cascadia Code, Consolas, Courier New" FontSize="13"
                                 Background="#1E1E1E" Foreground="#D4D4D4" BorderThickness="0"/>
                    </TabItem>
                    <TabItem Header="🎛️ Panel.axaml">
                        <TextBox Name="PanelEditor" AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="Cascadia Code, Consolas, Courier New" FontSize="13"
                                 Background="#1E1E1E" Foreground="#D4D4D4" BorderThickness="0"/>
                    </TabItem>
                    <TabItem Header="📜 History &amp; Diff">
                        <TextBox Name="HistoryViewer" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12"
                                 Background="#1E1E1E" Foreground="#9CDCFE" BorderThickness="0"/>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Right: Four-in-One Sandbox & Live Preview -->
            <Grid Grid.Column="1" RowDefinitions="Auto, *">
                <Border Background="#252526" Padding="10,6" BorderBrush="#333" BorderThickness="0,0,0,1">
                    <TextBlock Text="🔍 LIVE SANDBOX &amp; PREVIEW" FontWeight="Bold" Foreground="#4EC9B0"/>
                </Border>

                <TabControl Grid.Row="1">
                    <TabItem Header="🧪 Headless Benchmark">
                        <StackPanel Margin="12" Spacing="10">
                            <TextBlock Text="Command Parameter:" Foreground="#AAA"/>
                            <TextBox Name="TestParamBox" Text="P0.0,0.5" FontFamily="Cascadia Code" Background="#2D2D30"/>
                            
                            <Button Content="▶ Execute (Headless Sandbox)" Click="OnRunSandboxClick" 
                                    Background="#388A34" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch"/>

                            <Border Background="#1E1E1E" CornerRadius="4" Padding="8" Margin="0,10,0,0" Height="200">
                                <ScrollViewer>
                                    <TextBlock Name="SandboxOutputBlock" Text="Ready to run sandbox." 
                                               FontFamily="Cascadia Code" Foreground="#D4D4D4" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="🎨 Live XAML Preview">
                        <Border Name="XamlPreviewHost" Background="#2D2D30" Margin="8" CornerRadius="4" Padding="10">
                            <TextBlock Text="Live preview rendered from Wizard.axaml" Foreground="#888" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Bottom: Diagnostics & Compiler Output -->
        <Border Grid.Row="3" Background="#181818" Padding="10" BorderBrush="#333" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto, *">
                <TextBlock Text="💬 COMPILER &amp; MCP DIAGNOSTICS" FontWeight="SemiBold" Foreground="#888" Margin="0,0,0,4"/>
                <ScrollViewer Grid.Row="1">
                    <TextBox Name="DiagnosticsBox" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Cascadia Code, Consolas" FontSize="12"
                             Background="#181818" Foreground="#85C46C" BorderThickness="0"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
