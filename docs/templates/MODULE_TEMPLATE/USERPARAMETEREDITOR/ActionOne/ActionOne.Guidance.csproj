<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 雙模核心：WinExe 支援雙擊調試，同時產出 DLL 供 MVCON 動態載入 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 導引視窗命名規範：<Action>.Guidance.dll / .Guidance.exe -->
    <AssemblyName>ActionOne.Guidance</AssemblyName>
    <RootNamespace>MVCON.Guidance.ActionOne</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.0.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.10" />
    <ProjectReference Include="..\..\..\..\..\src\MVCON.Core\MVCON.Core.csproj" />
  </ItemGroup>
</Project>
