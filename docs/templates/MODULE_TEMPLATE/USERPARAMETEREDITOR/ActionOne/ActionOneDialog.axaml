<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ARCOS.Guidance.ActionOne.ActionOneDialog"
        Title="Template@ActionOne__Parameter.vi"
        Width="580" Height="420"
        CanResize="False" WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <!-- 頂部卡片：原始參數提示 -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="6" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Spacing="4">
                <TextBlock Text="⚙️ PARAMETER GUIDANCE : Template@ActionOne" FontWeight="Bold" Foreground="#1E293B" FontSize="14"/>
                <TextBlock x:Name="TxtParamIn" Text="ParameterIn: (None)" Foreground="#64748B" FontSize="11" FontFamily="Consolas"/>
            </StackPanel>
        </Border>

        <!-- 中央卡片：三段式高對比下拉選單 -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="6" Padding="16" Margin="0,12" BorderBrush="#CBD5E1" BorderThickness="1">
            <Grid ColumnDefinitions="*,100">
                <StackPanel Grid.Column="0" Spacing="14">
                    <!-- 1. 核心硬體或目標標的 (紅色邊框) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="🔴 Target Resource (目標資源 / IO 點位):" FontWeight="SemiBold" Foreground="#DC2626" FontSize="12"/>
                        <ComboBox x:Name="CmbTarget" HorizontalAlignment="Stretch" BorderBrush="#DC2626" BorderThickness="1.5" CornerRadius="4"/>
                    </StackPanel>

                    <!-- 2. 數值型參數 (藍色邊框) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="🔵 Delay (秒數):" FontWeight="SemiBold" Foreground="#2563EB" FontSize="12"/>
                        <ComboBox x:Name="CmbDelay" HorizontalAlignment="Stretch" BorderBrush="#2563EB" BorderThickness="1.5" CornerRadius="4"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右側大綠勾套用按鈕 -->
                <Button Grid.Column="1" x:Name="BtnApplyBig" Margin="12,16,0,0" Height="110"
                        Background="#10B981" Foreground="#FFFFFF" FontSize="36" FontWeight="Bold"
                        CornerRadius="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Content="✔" ToolTip.Tip="點擊立即套用並返回"/>
            </Grid>
        </Border>

        <!-- 底部卡片：即時組合輸出與操作按鈕 -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="6" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="ParameterOut (即時組合語法預覽):" FontSize="10" Foreground="#64748B"/>
                    <TextBox x:Name="TxtParamOut" IsReadOnly="True" FontWeight="Bold" Foreground="#0284C7" FontSize="12" FontFamily="Consolas"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnOk" Content="✔ 確定套用" Background="#2563EB" Foreground="#FFFFFF" Margin="12,0,0,0" Padding="14,6" CornerRadius="4"/>
                <Button Grid.Column="2" x:Name="BtnCancel" Content="✖ 取消" Background="#94A3B8" Foreground="#FFFFFF" Margin="8,0,0,0" Padding="14,6" CornerRadius="4"/>
            </Grid>
        </Border>
    </Grid>
</Window>
